        },
        "row_LTap7X": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/2_ebf85ad0-9f54-49bd-9d57-7ecc707c5213.png",
            "caption": "",
            "heading": "<strong>Sea Essences</strong>",
            "text": "<p>Our 24 Sea Essences promote transformations in consciousness. They can be used to attain major breakthroughs, move into spaces of greater perspective, and connect with the basic rhythms of the universe during periods of change.</p><p></p>",
            "button_label": "SHOP | SEA ESSENCES",
