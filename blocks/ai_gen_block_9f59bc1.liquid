{% doc %}
  @prompt
    I want to create a timeline layout where we can highlight key moments in our business journey from past to present-day, with options to include a key image for each timeline point, as well as a header and paragraph text., This is perfect - please adjust it to make it possible to add additional timeline items as needed, Use this timeline layout, but there needs to be 30 timeline items
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-timeline-container-{{ ai_gen_id }} {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
  }

  .ai-timeline-line-{{ ai_gen_id }} {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    transform: translateX(-50%);
  }

  .ai-timeline-item-{{ ai_gen_id }} {
    position: relative;
    margin-bottom: 60px;
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .ai-timeline-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-timeline-content-{{ ai_gen_id }} {
    flex: 1;
    background-color: {{ block.settings.card_background_color }};
    padding: 24px;
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-timeline-item-{{ ai_gen_id }}:nth-child(odd) {
    flex-direction: row;
  }

  .ai-timeline-item-{{ ai_gen_id }}:nth-child(even) {
    flex-direction: row-reverse;
  }

  .ai-timeline-item-{{ ai_gen_id }}:nth-child(odd) .ai-timeline-content-{{ ai_gen_id }} {
    text-align: right;
  }

  .ai-timeline-item-{{ ai_gen_id }}:nth-child(even) .ai-timeline-content-{{ ai_gen_id }} {
    text-align: left;
  }

  .ai-timeline-marker-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    width: {{ block.settings.marker_size }}px;
    height: {{ block.settings.marker_size }}px;
    background-color: {{ block.settings.marker_color }};
    border: {{ block.settings.marker_border_thickness }}px solid {{ block.settings.marker_border_color }};
    border-radius: 50%;
    flex-shrink: 0;
  }

  .ai-timeline-image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    max-width: 400px;
  }

  .ai-timeline-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: block;
  }

  .ai-timeline-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-timeline-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-timeline-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.date_font_size }}px;
    color: {{ block.settings.date_color }};
    font-weight: 600;
    margin-bottom: 8px;
  }

  .ai-timeline-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 700;
  }

  .ai-timeline-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_font_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .ai-timeline-line-{{ ai_gen_id }} {
      left: 20px;
    }

    .ai-timeline-item-{{ ai_gen_id }},
    .ai-timeline-item-{{ ai_gen_id }}:nth-child(odd),
    .ai-timeline-item-{{ ai_gen_id }}:nth-child(even) {
      flex-direction: column;
      align-items: flex-start;
      padding-left: 50px;
    }

    .ai-timeline-marker-{{ ai_gen_id }} {
      position: absolute;
      left: 0;
      top: 0;
    }

    .ai-timeline-content-{{ ai_gen_id }},
    .ai-timeline-item-{{ ai_gen_id }}:nth-child(odd) .ai-timeline-content-{{ ai_gen_id }},
    .ai-timeline-item-{{ ai_gen_id }}:nth-child(even) .ai-timeline-content-{{ ai_gen_id }} {
      text-align: left;
      width: 100%;
    }

    .ai-timeline-image-wrapper-{{ ai_gen_id }} {
      width: 100%;
      max-width: 100%;
    }
  }
{% endstyle %}

<timeline-block-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-timeline-container-{{ ai_gen_id }}">
    <div class="ai-timeline-line-{{ ai_gen_id }}"></div>

    {% for i in (1..30) %}
      {% liquid
        assign enabled_key = 'item_' | append: i | append: '_enabled'
        assign date_key = 'item_' | append: i | append: '_date'
        assign heading_key = 'item_' | append: i | append: '_heading'
        assign text_key = 'item_' | append: i | append: '_text'
        assign image_key = 'item_' | append: i | append: '_image'

        assign enabled = block.settings[enabled_key]
        assign date = block.settings[date_key]
        assign heading = block.settings[heading_key]
        assign text = block.settings[text_key]
        assign image = block.settings[image_key]
      %}

      {% if enabled %}
        <div class="ai-timeline-item-{{ ai_gen_id }}">
          <div class="ai-timeline-marker-{{ ai_gen_id }}"></div>

          <div class="ai-timeline-content-{{ ai_gen_id }}">
            {% if date != blank %}
              <div class="ai-timeline-date-{{ ai_gen_id }}">{{ date }}</div>
            {% endif %}

            {% if heading != blank %}
              <h3 class="ai-timeline-heading-{{ ai_gen_id }}">{{ heading }}</h3>
            {% endif %}

            {% if text != blank %}
              <div class="ai-timeline-text-{{ ai_gen_id }}">{{ text }}</div>
            {% endif %}
          </div>

          <div class="ai-timeline-image-wrapper-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
                class="ai-timeline-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-timeline-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</timeline-block-{{ ai_gen_id }}>

