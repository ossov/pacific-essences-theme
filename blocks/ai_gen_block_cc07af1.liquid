{% doc %}
  @prompt
    Create a timeline layout where we can highlight key moments in our business journey from past to present-day, with options to include a key image beside each timeline point alternating sides of the page, as well as a date field, header field, and paragraph text that accepts rich text including hyperlinks. There should be at least 30 timeline event entries possible, that can be turned inactive if not needed, and the timeline should be fully customizable in terms of font size and color., Add a customizable Title field to the very top of the timeline
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-timeline-main-title-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 700;
    margin: 0 0 {{ block.settings.title_bottom_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-timeline-container-{{ ai_gen_id }} {
    position: relative;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-timeline-line-{{ ai_gen_id }} {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: {{ block.settings.line_width }}px;
    background-color: {{ block.settings.line_color }};
    transform: translateX(-50%);
  }

  .ai-timeline-item-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: {{ block.settings.item_spacing }}px;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-timeline-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-timeline-item-left-{{ ai_gen_id }} {
    flex-direction: row-reverse;
  }

  .ai-timeline-item-right-{{ ai_gen_id }} {
    flex-direction: row;
  }

  .ai-timeline-content-{{ ai_gen_id }} {
    flex: 1;
    padding: {{ block.settings.content_padding }}px;
    background-color: {{ block.settings.content_bg_color }};
    border-radius: {{ block.settings.content_border_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-timeline-item-left-{{ ai_gen_id }} .ai-timeline-content-{{ ai_gen_id }} {
    text-align: right;
  }

  .ai-timeline-item-right-{{ ai_gen_id }} .ai-timeline-content-{{ ai_gen_id }} {
    text-align: left;
  }

  .ai-timeline-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.date_font_size }}px;
    color: {{ block.settings.date_color }};
    font-weight: 600;
    margin-bottom: 8px;
  }

  .ai-timeline-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 700;
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .ai-timeline-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_font_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-timeline-text-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-timeline-text-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-timeline-dot-{{ ai_gen_id }} {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    background-color: {{ block.settings.dot_color }};
    border: {{ block.settings.dot_border_width }}px solid {{ block.settings.dot_border_color }};
    border-radius: 50%;
    z-index: 2;
  }

  .ai-timeline-image-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.image_width }}px;
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-timeline-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-timeline-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-timeline-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 768px) {
    .ai-timeline-main-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.8 }}px;
    }

    .ai-timeline-line-{{ ai_gen_id }} {
      left: 20px;
    }

    .ai-timeline-item-{{ ai_gen_id }},
    .ai-timeline-item-left-{{ ai_gen_id }},
    .ai-timeline-item-right-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      padding-left: 50px;
    }

    .ai-timeline-content-{{ ai_gen_id }},
    .ai-timeline-item-left-{{ ai_gen_id }} .ai-timeline-content-{{ ai_gen_id }},
    .ai-timeline-item-right-{{ ai_gen_id }} .ai-timeline-content-{{ ai_gen_id }} {
      text-align: left;
    }

    .ai-timeline-dot-{{ ai_gen_id }} {
      left: 20px;
      top: 30px;
    }

    .ai-timeline-image-{{ ai_gen_id }} {
      width: 100%;
      flex: 1 1 auto;
    }

    .ai-timeline-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.85 }}px;
    }

    .ai-timeline-date-{{ ai_gen_id }} {
      font-size: {{ block.settings.date_font_size | times: 0.9 }}px;
    }

    .ai-timeline-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<business-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.main_title != blank %}
    <h2 class="ai-timeline-main-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
  {% endif %}

  <div class="ai-timeline-container-{{ ai_gen_id }}">
    <div class="ai-timeline-line-{{ ai_gen_id }}"></div>

    {% for i in (1..30) %}
      {% liquid
        assign enabled_key = 'event_' | append: i | append: '_enabled'
        assign date_key = 'event_' | append: i | append: '_date'
        assign heading_key = 'event_' | append: i | append: '_heading'
        assign text_key = 'event_' | append: i | append: '_text'
        assign image_key = 'event_' | append: i | append: '_image'

        assign enabled = block.settings[enabled_key]
        assign date = block.settings[date_key]
        assign heading = block.settings[heading_key]
        assign text = block.settings[text_key]
        assign image = block.settings[image_key]

        assign remainder = i | modulo: 2
        if remainder == 1
          assign position = 'left'
        else
          assign position = 'right'
        endif
      %}

      {% if enabled %}
        <div class="ai-timeline-item-{{ ai_gen_id }} ai-timeline-item-{{ position }}-{{ ai_gen_id }}">
          <div class="ai-timeline-content-{{ ai_gen_id }}">
            {% if date != blank %}
              <div class="ai-timeline-date-{{ ai_gen_id }}">{{ date }}</div>
            {% endif %}

            {% if heading != blank %}
              <h3 class="ai-timeline-heading-{{ ai_gen_id }}">{{ heading }}</h3>
            {% endif %}

            {% if text != blank %}
              <div class="ai-timeline-text-{{ ai_gen_id }}">{{ text }}</div>
            {% endif %}
          </div>

          <div class="ai-timeline-dot-{{ ai_gen_id }}"></div>

          <div class="ai-timeline-image-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ heading | escape }}"
                loading="lazy"
                width="{{ block.settings.image_width }}"
                height="{{ block.settings.image_height }}"
              >
            {% else %}
              <div class="ai-timeline-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</business-timeline-{{ ai_gen_id }}>

<script>
  (function() {
    class BusinessTimeline{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustTimelineHeight();
      }

      adjustTimelineHeight() {
        const line = this.querySelector('.ai-timeline-line-{{ ai_gen_id }}');
        const items = this.querySelectorAll('.ai-timeline-item-{{ ai_gen_id }}');
        
        if (items.length > 0 && line) {
          const firstItem = items[0];
          const lastItem = items[items.length - 1];
          const containerRect = this.querySelector('.ai-timeline-container-{{ ai_gen_id }}').getBoundingClientRect();
          const firstRect = firstItem.getBoundingClientRect();
          const lastRect = lastItem.getBoundingClientRect();
          
          const topOffset = firstRect.top - containerRect.top + 30;
          const bottomOffset = lastRect.bottom - containerRect.top - 30;
          
          line.style.top = topOffset + 'px';
          line.style.bottom = 'auto';
          line.style.height = (bottomOffset - topOffset) + 'px';
        }
      }
    }

    customElements.define('business-timeline-{{ ai_gen_id }}', BusinessTimeline{{ ai_gen_id }});
  })();
</script>

