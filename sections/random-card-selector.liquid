{%- comment -%}
  The card, the copy beside it, and the band behind them. The markup for the
  card itself is untouched — the flip animation is driven by these element ids
  and by the is-spinning / is-revealing / is-locked classes, so only the
  wrapper around them has changed.

  Heading, description and button label are section settings now. They were
  locale strings, which meant they could only be edited by hand in
  locales/*.json rather than in the theme editor. Leave one blank and it falls
  back to the locale string, so existing translations still work.
{%- endcomment -%}

{%- liquid
  assign rcs_heading = section.settings.heading
  if rcs_heading == blank
    assign rcs_heading = 'sections.random_card_selector.heading' | t
  endif
  assign rcs_button = section.settings.button_label
  if rcs_button == blank
    assign rcs_button = 'sections.random_card_selector.button_text' | t
  endif
  assign rcs_body = section.settings.description
  if rcs_body == blank
    assign rcs_body = 'sections.random_card_selector.description' | t
  endif
-%}

<random-card-selector class="random-card-selector section-{{ section.id }}" data-section-id="{{ section.id }}">

  <div class="random-card-selector__container page-width rcs-layout">

    <div class="random-card-selector__display" id="RandomCardSelectorDisplay-{{ section.id }}">
      
      <div class="random-card-selector__card-wrapper">
        <img
          src=""
          alt="{{ 'sections.random_card_selector.card_alt_placeholder' | t }}"
          class="random-card-selector__card-image random-card-selector__card-image--front"
          id="RandomCardSelectorFrontImage-{{ section.id }}"
          loading="lazy"
          width="300"
          height="450"
        >
        <img
          src=""
          alt="{{ 'sections.random_card_selector.card_alt_placeholder' | t }}"
          class="random-card-selector__card-image random-card-selector__card-image--back"
          id="RandomCardSelectorBackImage-{{ section.id }}"
          loading="lazy"
          width="300"
          height="450"
        >
        <!-- NEW (idea 4): shine sweep overlay -->
        <span class="random-card-selector__shine" aria-hidden="true"></span>
      </div>
    </div>

    <div class="rcs-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rcs-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="random-card-selector__heading">{{ rcs_heading }}</h2>

      {%- if rcs_body != blank -%}
        <p class="random-card-selector__description">{{ rcs_body }}</p>
      {%- endif -%}

      {%- if rcs_button != blank -%}
        <button type="button" class="random-card-selector__button button" id="RandomCardSelectorButton-{{ section.id }}">
          {{ rcs_button }}
        </button>
      {%- else -%}
        {%- comment -%} The id has to exist for the script even with no label. {%- endcomment -%}
        <button type="button" class="random-card-selector__button button visually-hidden" id="RandomCardSelectorButton-{{ section.id }}">
          {{ 'sections.random_card_selector.heading' | t }}
        </button>
      {%- endif -%}
    </div>

  </div>

</random-card-selector>

{% style %}
  /* ---- the band -------------------------------------------------------- */
  .section-{{ section.id }}.random-card-selector {
    /* A custom element is inline by default, so the padding and the band both
       had nothing to sit on. */
    display: block;
    background: linear-gradient(160deg, {{ section.settings.band_from }} 0%, {{ section.settings.band_to }} 100%);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    color: {{ section.settings.body_color }};
  }

  /* Card on one side, the words on the other, rather than stacked down the
     middle of an empty white section. */
  .section-{{ section.id }} .rcs-layout {
    display: grid;
    /* Wide enough for two cards: a drawn card shows its front and its back
       side by side, so this column has to hold the pair, not one card. */
    grid-template-columns: minmax(0, {{ section.settings.card_width }}px) minmax(0, 1fr);
    align-items: center;
    gap: 4rem;
    max-width: 104rem;
  }

  .section-{{ section.id }} .random-card-selector__display {
    width: 100%;
    margin: 0;
    min-width: 0;
  }
  .section-{{ section.id }} .random-card-selector__card-wrapper {
    max-width: none;
    gap: 14px;
    filter: drop-shadow(0 22px 40px rgba(0, 0, 0, 0.42));
  }
  .section-{{ section.id }} .random-card-selector__card-image {
    border: 0;
    /* Flex items default to min-width:auto, which for an image is its
       intrinsic width — so the pair could not shrink and overflowed onto the
       words beside them. One card shows at its own size; two share the room. */
    min-width: 0;
  }

  .section-{{ section.id }} .rcs-copy { text-align: left; }

  .section-{{ section.id }} .rcs-eyebrow {
    margin: 0 0 8px;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
  }

  .section-{{ section.id }} .random-card-selector__heading {
    /* The section ships a gradient text fill on this heading; the transparent
       -webkit-text-fill-color it sets beats any colour, so it has to be
       cleared before the band colour can show. */
    background: none;
    -webkit-background-clip: border-box;
    background-clip: border-box;
    -webkit-text-fill-color: currentColor;
    margin: 0 0 12px;
    font-size: clamp(2.4rem, 1.8rem + 1.2vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: {{ section.settings.heading_color }};
    text-align: left;
    text-wrap: balance;
  }

  .section-{{ section.id }} .random-card-selector__description {
    margin: 0 0 24px;
    max-width: 46ch;
    font-size: 1.6rem;
    line-height: 1.65;
    color: {{ section.settings.body_color }};
  }

  .section-{{ section.id }} .random-card-selector__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 5rem;
    padding: 0 3rem;
    border: 0;
    border-radius: 999px;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0;
    color: {{ section.settings.button_text_color }};
    background: {{ section.settings.button_color }};
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
    transition: transform 0.15s ease, box-shadow 0.2s ease;
  }
  .section-{{ section.id }} .random-card-selector__button:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.34);
    background: {{ section.settings.button_color }};
  }
  .section-{{ section.id }} .random-card-selector__button::after { display: none; }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .rcs-layout {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 2.6rem;
    }
    .section-{{ section.id }} .rcs-copy,
    .section-{{ section.id }} .random-card-selector__heading { text-align: center; }
    .section-{{ section.id }} .random-card-selector__description { margin-inline: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }} .random-card-selector__button { transition: none; }
  }
{% endstyle %}

<style>
  /* Scoped CSS for the Random Card Selector section */
  .random-card-selector {
    padding: var(--spacing-section-vertical, 40px) 0;
    text-align: center;
    background-color: var(--color-background, #ffffff);
    color: var(--color-foreground, #333333);
  }
  .random-card-selector__container {
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--spacing-page-horizontal, 20px);
    padding-right: var(--spacing-page-horizontal, 20px);
  }
  .random-card-selector__heading {
    font-weight: bold;
    font-size: 3rem;
    margin-bottom: var(--spacing-base, 15px);
    color: var(--color-heading, #000000);
    background: linear-gradient(90deg,rgb(33, 160, 244),rgb(237, 49, 247)); 
    -webkit-background-clip: text;
    background-clip: text; 
    -webkit-text-fill-color: transparent;
  }
  .random-card-selector__description {
    font-size: var(--font-body-scale, 1rem);
    margin-bottom: var(--spacing-large, 30px);
    line-height: 1.5;
    font-weight: bold;
  }
  .random-card-selector__button {
    display: none;
    padding: var(--spacing-small, 12px) var(--spacing-medium, 25px);
    font-size: var(--font-body-scale, 1rem);
    font-weight: var(--font-weight-bold, 700);
    text-decoration: none;
    cursor: pointer;
    border: 2px solid var(--color-button-border, #43A6DB);
    background-color: var(--color-button-background, #43A6DB);
    color: #ffffff;
    border-radius: var(--border-radius-button, 50px);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    margin-bottom: var(--spacing-large, 10px);
    margin-top: 40px;
  }
  .random-card-selector__button:hover {
    background-color: var(--color-button-background-hover, #ffffff);
    color: var(--color-button-text-hover, #43A6DB);
    border-color: var(--color-button-border-hover, #43A6DB);
  }
  .random-card-selector__button:focus {
    outline: none !important;
    box-shadow: none !important;
    shadow: none !important;
  }
  .random-card-selector__display {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-medium, 20px);
    min-height: 200px;
  }
  .random-card-selector__message {
    font-size: var(--font-body-scale, 1rem);
    font-weight: var(--font-weight-bold, 700);
    color: var(--color-accent, #007bff);
    min-height: 1.5em;
  }
  .random-card-selector__card-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-medium, 20px);
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 650px;
    perspective: 1000px;
    position: relative;              /* NEW: anchor for the shine overlay */
  }
    .random-card-selector__card-image {
    max-width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--color-border, #cccccc);
    box-shadow: var(--shadow-card, 0 4px 8px rgba(0, 0, 0, 0.1));
    border-radius: var(--border-radius-card, 8px);
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.3s ease;
    transform-style: preserve-3d;
    will-change: transform;
    cursor: pointer;
  }
  .random-card-selector__card-image.is-loaded {
    opacity: 1;
  }

  /* Single 1.4s spin. Timing is controlled per-keyframe below so the mid-flip
     swap stays hidden, but the finish decelerates instead of stopping dead. */
  .random-card-selector__card-image.is-spinning {
    animation: rotate-y 1.4s;
  }

  /* NEW: once a card is picked, no more clicking */
  .random-card-selector.is-locked .random-card-selector__card-image {
    cursor: default;
    pointer-events: none;
  }

  /* CHANGED (idea 2): "land it, don't stop it"
     - Linear up to 62.5% (875ms) so the card is edge-on exactly when the JS
       swaps the images — the swap stays invisible.
     - Then ease-out into the final turn so it decelerates and settles.
     - A gentle scale-up mid-flip makes the card lift toward you, then relax. */
  @keyframes rotate-y {
    0% {
      transform: rotateY(0deg) scale(1);
      animation-timing-function: linear;
    }
    62.5% {
      transform: rotateY(450deg) scale(1.06);
      animation-timing-function: ease-out;
    }
    100% {
      transform: rotateY(720deg) scale(1);
    }
  }

  /* NEW (idea 4): shine sweep on reveal */
  .random-card-selector__shine {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    border-radius: var(--border-radius-card, 8px);
  }
  .random-card-selector__shine::before {
    content: "";
    position: absolute;
    top: -25%;
    left: 0;
    width: 40%;
    height: 150%;
    background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: translateX(-250%) skewX(-15deg);
  }
  .random-card-selector.is-revealing .random-card-selector__shine {
    opacity: 1;
  }
  .random-card-selector.is-revealing .random-card-selector__shine::before {
    animation: rcs-shine 0.85s ease-out;
  }
  @keyframes rcs-shine {
    from { transform: translateX(-250%) skewX(-15deg); }
    to   { transform: translateX(350%)  skewX(-15deg); }
  }

  @media screen and (min-width: 750px) {
    .random-card-selector__card-wrapper {
      flex-direction: row;
    }
    .random-card-selector__card-image {
      max-width: 300px;
    }
  }
</style>

<script>
  class RandomCardSelector extends HTMLElement {
    constructor() {
      super();
      this.sectionId = this.dataset.sectionId;
      this.button = this.querySelector(`#RandomCardSelectorButton-${this.sectionId}`);
      this.frontImage = this.querySelector(`#RandomCardSelectorFrontImage-${this.sectionId}`);
      this.backImage = this.querySelector(`#RandomCardSelectorBackImage-${this.sectionId}`);
      this.maxCardNumber = 84;

      this.hasPicked = false;   // one pick per page load (resets on reload)
      this.isSpinning = false;

      if (this.button) {
        this.button.addEventListener('click', () => this.pickRandomCard());
      }
      if (this.frontImage) {
        this.frontImage.addEventListener('click', () => this.pickRandomCard());
      }
      if (this.backImage) {
        this.backImage.addEventListener('click', () => this.pickRandomCard());
      }
    }

    connectedCallback() {
      this.displayInitialCards();
      this.prepareChosenCard();   // NEW: pick + start downloading the card up front
    }

    displayInitialCards() {
      const initialCard1Url = "https://cdn.shopify.com/s/files/1/0261/2661/4621/files/Card-Box.png?v=1756158367";
      const altText = `{{ 'sections.random_card_selector.card_alt_placeholder' | t }}`;

      if (this.frontImage && this.backImage) {
        this.frontImage.src = initialCard1Url;
        this.frontImage.alt = altText;
        this.frontImage.classList.add('is-loaded');
        this.backImage.style.display = 'none';
      }
    }

    // NEW: choose the random card and begin downloading it as soon as the page
    // loads, so it's ready (cached) long before the visitor clicks. This is what
    // keeps the mid-spin swap seamless every time instead of only sometimes.
    prepareChosenCard() {
      const cardNumber = Math.floor(Math.random() * this.maxCardNumber) + 1;
      const formattedCardNumber = String(cardNumber).padStart(2, '0');
      const baseUrl = "https://cdn.shopify.com/s/files/1/0261/2661/4621/files/";

      this.chosenCard = {
        cardNumber,
        preload: Promise.all([
          this.preloadImage(`${baseUrl}card_${formattedCardNumber}_txt.jpg`),
          this.preloadImage(`${baseUrl}card_${formattedCardNumber}_img.jpg`)
        ])
      };
      // Ignore a failed pre-download here; pickRandomCard() will surface it.
      this.chosenCard.preload.catch(() => {});
    }

    preloadImage(imageUrl) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = () => reject(new Error(`Failed to preload image: ${imageUrl}`));
        img.src = imageUrl;
      });
    }

    async pickRandomCard() {
      // Only one pick per page load, and ignore clicks mid-spin
      if (this.hasPicked || this.isSpinning) return;
      this.isSpinning = true;

      // Must match the CSS: single 1.4s animation
      const duration = 1400;
      // Edge-on (card invisible) at the 62.5% keyframe = 875ms. We swap there.
      const swapPoint = 875;

      try {
        // Use the card we chose + started downloading on page load.
        const { cardNumber, preload } = this.chosenCard;

        // Reveal the 2nd card (using the current placeholder) and START THE
        // SPIN RIGHT AWAY — instant feedback.
        const placeholder = this.frontImage.src;
        this.backImage.src = placeholder;
        this.backImage.style.display = 'block';
        this.backImage.classList.add('is-loaded');
        this.frontImage.classList.add('is-spinning');
        this.backImage.classList.add('is-spinning');

        // Wait for the edge-on moment. Because the images were already
        // downloaded on page load, `preload` is normally done well before
        // 875ms, so the swap lands exactly at edge-on = seamless.
        const [frontImg, backImg] = await Promise.all([
          preload,
          new Promise(resolve => setTimeout(resolve, swapPoint))
        ]).then(([imgs]) => imgs);

        // Invisible swap while the card is edge-on
        this.frontImage.src = frontImg.src;
        this.backImage.src = backImg.src;
        const frontAltTemplate = `{{ 'sections.random_card_selector.card_front_alt' | t }}`;
        const backAltTemplate = `{{ 'sections.random_card_selector.card_back_alt' | t }}`;
        this.frontImage.alt = frontAltTemplate.replace('[card_number]', cardNumber);
        this.backImage.alt = backAltTemplate.replace('[card_number]', cardNumber);

        // Fire the shine sweep as the card reveals
        this.classList.add('is-revealing');

        // Let the spin finish naturally (no early cut-off = no snap)
        await new Promise(resolve => setTimeout(resolve, duration - swapPoint));

      } catch (error) {
        console.error("Error picking card:", error);
      } finally {
        this.frontImage.classList.remove('is-spinning');
        this.backImage.classList.remove('is-spinning');
        // Lock it: no more picks until the page is reloaded
        this.hasPicked = true;
        this.isSpinning = false;
        this.classList.add('is-locked');
      }
    }
  }

  if (!customElements.get('random-card-selector')) {
    customElements.define('random-card-selector', RandomCardSelector);
  }
</script>
{% schema %}
{
  "name": "t:sections.random_card_selector.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Today"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick a card for your daily inspiration",
      "info": "Leave empty to use the translated text from the language files instead."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A card drawn at random, to sit with for the day. If the same one keeps arriving, there is probably a reason.",
      "info": "Placeholder wording — replace it with your own."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Draw a card"
    },
    {
      "type": "header",
      "content": "Band"
    },
    {
      "type": "color",
      "id": "band_from",
      "label": "Background, top",
      "default": "#0f3446"
    },
    {
      "type": "color",
      "id": "band_to",
      "label": "Background, bottom",
      "default": "#16495f"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow colour",
      "default": "#7fc4e2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#eaf6fb"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Text colour",
      "default": "#9dc0d1"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#eaf6fb"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#0f3446"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 240,
      "max": 640,
      "step": 20,
      "unit": "px",
      "label": "Card area width",
      "default": 440,
      "info": "A drawn card shows both faces side by side, so this is the width of the pair."
    },
    {
      "type": "range",
      "id": "padding_top",
