<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="page-width">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--3-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__info-wrapper-left">
        {%- assign product_form_id = 'product-form-' | append: section.id -%}

        {% assign split_title = product.title | split: '|' %}
        <h1 class="product__title">{{ split_title[0] | strip }}</h1>
        <div class="product-type">
          {{ split_title[1] | strip }}
        </div>

        {%- if product.metafields.custom.resonance != blank -%}
          <div class="product__resonance-metafield">
            <p>{{ product.metafields.custom.resonance }}</p>
          </div>
        {%- endif -%}
        {% comment %}
        {%- if product.metafields.custom.size.value != blank and product.metafields.custom.size.value != 0 -%}
          <p class="product-size">{{ product.metafields.custom.size.value }}</p>
        {%- endif -%}
        {% endcomment %}

        

      </div>
      <div class="grid__item product__media-wrapper">
        {%- if product.gift_card? -%}
          <div style="border-radius: 12px; overflow: hidden; position: sticky; top: 3rem;">
            <img 
              src="{{ product.featured_image | image_url: width: 1000 }}" 
              alt="{{ product.title | escape }}"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              style="width: 100%; height: auto; display: block;"
              loading="eager"
            >
          </div>
        {%- else -%}
          {% render 'product-media-gallery', variant_images: variant_images %}
        {%- endif -%}
        {%- if template.suffix == 'variant-template' -%}
                  {%- assign picker_block = section.blocks | where: "type", "variant_picker" | first -%}
                  {%- if picker_block -%}
                    {% render 'product-variant-picker', 
                      product: product, 
                      block: picker_block, 
                      product_form_id: product_form_id 
                    %}
                  {%- endif -%}
                {%- endif -%}
                {% comment %}
                {%- if template.suffix == 'variant-template' -%}
                  <product-form class="product-form">
                    {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input
                        type="hidden"
                        name="id"
                        value="{{ product.selected_or_first_available_variant.id }}"
                        class="product-variant-id"
                      >
                      <div class="product-form__buttons">
                        <button
                          id="ProductSubmitButton-{{ section.id }}"
                          type="submit"
                          name="add"
                          class="product-form__submit button button--full-width button--primary"
                        >
                          <span>
                            {%- if product.selected_or_first_available_variant.available == false -%}
                              Sold Out
                            {%- else -%}
                              Add to Cart
                            {%- endif -%}
                          </span>
                        </button>
                      </div>
                    {%- endform -%}
                  </product-form>
                {%- endif -%}
                {% endcomment %}
      </div>
      
      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <section>
      
          {%- if product.metafields.custom.short_description_v2 != blank -%}
            {% assign hide_essence_header = false %}
            {% assign product_title_lowercase = product.title | downcase %}
            
            {% comment %} Check for Energy Medicine collection {% endcomment %}
            {% for collection in product.collections %}
              {% if collection.handle == "energy-medicine-books-classes-cards" %}
                {% assign hide_essence_header = true %}
              {% endif %}
            {% endfor %}
            
            {% comment %} Check for kit in product title {% endcomment %}
            {% if product_title_lowercase contains "kit" %}
              {% assign hide_essence_header = true %}
            {% endif %}
            
            {% comment %} Check for specific tag - replace 'no-essence-heading' with your actual tag {% endcomment %}
            {% if product.tags contains 'no-header' %}
              {% assign hide_essence_header = true %}
            {% endif %}

            {% unless hide_essence_header %}
              <h2 class="product__description-heading">This Essence Can Help With:</h2>
            {% endunless %}
            
            <div class="product__short-description rte">
              {{ product.metafields.custom.short_description_v2 | metafield_tag }}
            </div>
          {%- endif -%}

          {% comment %}
          <div class="custom-quantity-price-wrapper">
      
            <div id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
              {%- render 'price',
                product: product,
                use_variant: true,
                show_badges: true,
                price_class: 'price--large'
              -%}
              {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                <div class="product__tax caption rte">
                  {%- if cart.taxes_included -%}
                    {{ 'products.product.taxes_included' | t }}
                  {%- endif -%}
                  {%- if shop.shipping_policy.body != blank -%}
                    {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
      
            <div id="Quantity-Form-{{ section.id }}" class="product-form__input product-form__quantity">
              <quantity-input class="quantity custom-quantity">
                <button class="quantity__button custom-quantity__button" name="minus" type="button">
                  <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}</span>
                  <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
                </button>
                <input 
                  class="quantity__input custom-quantity__input" 
                  type="number" 
                  name="quantity" 
                  id="Quantity-{{ section.id }}" 
                  min="1" 
                  value="1" 
                  form="{{ product_form_id }}"
                  onkeydown="return false;"
                >
                <button class="quantity__button custom-quantity__button" name="plus" type="button">
                  <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: product.title | escape }}</span>
                  <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                </button>
              </quantity-input>
            </div>
      
          </div>
      
          {%- render 'buy-buttons',
            block: block,
            product: product,
            product_form_id: product_form_id,
            section_id: section.id,
            show_pickup_availability: true
          -%}
           {% endcomment %}

           

        </section>
      </div> 
    </div>

    {%- if product.gift_card? -%}
      <style>
        /* This ensures the internal form fields stretch nicely and don't bunch up */
        .gift-card-standalone-block .customer {
          width: 100%;
          max-width: 45rem; 
        }
        
        /* This perfectly centers the checkbox and its label text */
        .gift-card-standalone-block label.recipient-checkbox {
          display: flex;
          justify-content: center;
          align-items: center;
          width: 100%;
        }

        .gift-card-standalone-block svg.icon.icon-checkmark {
          display: none;
          justify-content: center;
          align-items: center;
          width: 100%;
        }

        .gift-card-standalone-block svg {
          display: none;
          justify-content: center;
          align-items: center;
          width: 100%;
        }

        /* Transforms the text span into a clickable button (White with Blue Text) */
        .gift-card-standalone-block label.recipient-checkbox span {
          display: inline-block;
          padding: 1.2rem 3rem;
          background-color: #ffffff; /* White background */
          color: #2A87B9; /* Brand Blue text */
          border: 1px solid #2A87B9; /* Brand Blue border */
          border-radius: 50px;
          font-size: 1.5rem;
          font-weight: bold;
          letter-spacing: 0.1rem;
          cursor: pointer;
          transition: all 0.3s ease; /* Slightly smoothed out the transition speed */
          text-align: center;
        }

        /* Inverts to Blue background and White text on hover */
        .gift-card-standalone-block label.recipient-checkbox span:hover {
          background-color: #2A87B9; /* Brand Blue background */
          color: #ffffff; /* White text */
          border: 1px solid #2A87B9; /* Keeps the border blue so the button size stays perfectly stable */
        }

        /* Rounds the corners of the text boxes and the message area */
        .gift-card-standalone-block .field__input,
        .gift-card-standalone-block .field::before,
        .gift-card-standalone-block .field::after {
          border-radius: 12px; 
        }

      </style>
      
      <div class="gift-card-standalone-block" style="margin: 0rem 0; padding: 1rem; background-color: transparent; border-radius: 1rem;">
        <h2 class="h3" style="margin-top: 0; margin-bottom: 0rem; text-align: center;"></h2>
        
        <!-- The display: flex and justify-content: center force the .customer div into the middle -->
        <div style="max-width: 60rem; margin: 0 auto; display: flex; justify-content: center; width: 100%;">
          {%- render 'gift-card-recipient-form', product: product, section: section -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%}
      The buy box. Price on its own line with the currency and size beside it,
      then quantity and add-to-cart sharing a row, then the guide prompt and the
      reassurance line. The old .custom-quantity-price-wrapper that fused price
      and quantity into one pill is gone, so the rules targeting it in
      custom-styles.css no longer apply.
    {%- endcomment -%}
    <div class="product__purchase-wrapper">

      <div
        class="pe-price"
        data-price-block
        data-money-format="{{ shop.money_format | escape }}"
        data-variant-prices='{% for v in product.variants %}{% unless forloop.first %},{% endunless %}"{{ v.id }}":[{{ v.price }},{{ v.compare_at_price | default: 0 }}]{% endfor %}'
        data-form-id="{{ product_form_id }}"
      >
        <div id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
          {%- render 'price',
            product: product,
            use_variant: true,
            show_badges: true,
            price_class: 'price--large'
          -%}
        </div>
        {%- capture price_meta -%}{{ shop.currency }}{% if product.metafields.custom.size.value != blank and product.metafields.custom.size.value != 0 %} &middot; {{ product.metafields.custom.size.value }}{% endif %}{%- endcapture -%}
        <span class="pe-price__meta">{{ price_meta }}</span>
      </div>

      {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
        <div class="product__tax caption rte">
          {%- if cart.taxes_included -%}
            {{ 'products.product.taxes_included' | t }}
          {%- endif -%}
          {%- if shop.shipping_policy.body != blank -%}
            {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="pe-qtyrow">
    <div id="Quantity-Form-{{ section.id }}" class="product-form__input product-form__quantity">
      <quantity-input class="quantity custom-quantity">
        <button class="quantity__button custom-quantity__button" name="minus" type="button">
          <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}</span>
          <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
        </button>
        <input 
          class="quantity__input custom-quantity__input" 
          type="number" 
          name="quantity" 
          id="Quantity-{{ section.id }}" 
          min="1" 
          value="1" 
          form="{{ product_form_id }}"
          onkeydown="return false;"
        >
        <button class="quantity__button custom-quantity__button" name="plus" type="button">
          <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: product.title | escape }}</span>
          <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
        </button>
      </quantity-input>
    </div>
        {%- render 'buy-buttons',
          block: block,
          product: product,
          product_form_id: product_form_id,
          section_id: section.id,
          show_pickup_availability: true
        -%}
      </div>

      {%- comment -%}
        The guide only knows about combination essences, so the prompt is gated
        on the essence type. Singles carry their own name here
        ("Blue Camas Flower Essence"); combinations carry "Combination".
      {%- endcomment -%}
      {%- assign guide_match = section.settings.guide_only_when | default: 'Combination' -%}
      {%- assign essence_type_value = product.metafields.custom.essence_type.value | default: product.metafields.custom.essence_type -%}
      {%- if section.settings.guide_label != blank and essence_type_value contains guide_match -%}
        {%- assign essence_name = split_title[0] | strip | default: product.title -%}
        {%- assign guide_prompt = section.settings.guide_prompt | default: 'Is [product] right for me?' | replace: '[product]', essence_name -%}
        <button
          type="button"
          class="pe-btn-ghost"
          data-guide-open
          data-guide-prompt="{{ guide_prompt | escape }}"
          aria-haspopup="dialog"
        >
          {{- section.settings.guide_label | escape -}}
        </button>
      {%- endif -%}

    {%- comment -%}
      The guide, in a dialog on this page rather than a trip to the homepage.
      The widget is mounted here on load and seeded with a question about this
      essence when the button is pressed.
    {%- endcomment -%}
    {%- if section.settings.guide_label != blank and essence_type_value contains guide_match -%}
      <div class="pe-guide" id="pe-guide-{{ section.id }}" hidden>
        <div class="pe-guide__backdrop" data-guide-close></div>
        <div class="pe-guide__panel" role="dialog" aria-modal="true" aria-label="{{ section.settings.guide_label | escape }}">
          <button type="button" class="pe-guide__close" data-guide-close aria-label="{{ 'accessibility.close' | t }}">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          <div id="essence-chat-product-{{ section.id }}" class="pe-guide__mount"></div>
        </div>
      </div>

      <script
        src="{{ 'essence-chat.js' | asset_url }}"
        data-mount="#essence-chat-product-{{ section.id }}"
        data-endpoint="{{ section.settings.guide_endpoint | default: '/apps/essence-chat/chat-v2' | escape }}"
        data-accent="#2a87b9"
        data-placeholder="{{ section.settings.guide_label | escape }}"
        defer
      ></script>

      <script>
        (function () {
          var root = document.getElementById('pe-guide-{{ section.id }}');
          var opener = document.querySelector('[data-guide-open]');
          if (!root || !opener) return;
          var lastFocus = null;

          function close() {
            root.hidden = true;
            document.body.style.overflow = '';
            if (lastFocus) lastFocus.focus();
          }

          function seed(text) {
            // The widget renders on a deferred script, so wait for its textarea
            // rather than assuming it is there.
            var tries = 0;
            (function poll() {
              var ta = root.querySelector('.ec-hero textarea');
              var form = ta && ta.closest('form');
              if (!ta || !form) {
                if (++tries > 60) return;
                return setTimeout(poll, 100);
              }
              if (form.dataset.seeded) { ta.focus(); return; }
              form.dataset.seeded = '1';
              ta.value = text;
              ta.dispatchEvent(new Event('input', { bubbles: true }));
              form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
            })();
          }

          opener.addEventListener('click', function () {
            lastFocus = opener;
            root.hidden = false;
            document.body.style.overflow = 'hidden';
            // Let the dialog lay out before seeding. Submitting in the same
            // frame starts the widget's fade while it is still display:none,
            // and the transition never completes: the panel sticks part-faded.
            //
            // A timer rather than requestAnimationFrame: rAF does not fire in a
            // background or hidden tab, which would leave the dialog open and
            // the question never sent.
            setTimeout(function () {
              seed(opener.getAttribute('data-guide-prompt') || '');
            }, 60);
          });

          root.addEventListener('click', function (e) {
            if (e.target.closest('[data-guide-close]')) close();
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !root.hidden) close();
          });
        })();
      </script>
    {%- endif -%}

      {%- comment -%}
        The displayed price follows the quantity. Shopify still does the real
        arithmetic at checkout; this only keeps the number on screen honest.
      {%- endcomment -%}
      {%- raw -%}
      <script>
        (function () {
          var block = document.currentScript.closest('.product__purchase-wrapper');
          if (!block) return;
          var priceBlock = block.querySelector('[data-price-block]');
          var qtyInput = block.querySelector('input[name="quantity"]');
          if (!priceBlock || !qtyInput) return;

          var prices;
          try { prices = JSON.parse('{' + priceBlock.getAttribute('data-variant-prices') + '}'); }
          catch (e) { return; }

          var format = priceBlock.getAttribute('data-money-format') || '${{amount}}';

          function money(cents) {
            var n = cents / 100;
            return format.replace(/\{\{\s*(\w+)\s*\}\}/g, function (_, token) {
              if (token === 'amount_no_decimals') return Math.round(n).toLocaleString('en');
              if (token === 'amount_with_comma_separator') {
                return n.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
              }
              return n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            });
          }

          function currentVariant() {
            var form = document.getElementById(priceBlock.getAttribute('data-form-id'));
            var field = form && form.querySelector('input[name="id"], select[name="id"]');
            return field ? field.value : Object.keys(prices)[0];
          }

          // Always computed from the stored unit prices, never from what is on
          // screen, so repeated updates cannot compound.
          //
          // Dawn renders two elements carrying .price-item--regular: a hidden
          // one inside .price__regular holding the current price, and the
          // visible struck-through compare-at inside .price__sale. Writing the
          // price into both wipes out the compare-at, so they are separated.
          function apply() {
            var pair = prices[currentVariant()];
            if (!pair) return;
            var unit = pair[0];
            var compareAt = pair[1];
            var qty = parseInt(qtyInput.value, 10);
            if (!qty || qty < 1) qty = 1;

            var unitText = money(unit * qty);

            priceBlock.querySelectorAll('.price__regular .price-item--regular').forEach(function (el) {
              el.textContent = unitText;
            });
            priceBlock.querySelectorAll('.price-item--sale').forEach(function (el) {
              el.textContent = unitText;
            });
            if (compareAt > 0) {
              priceBlock.querySelectorAll('.price__sale .price-item--regular').forEach(function (el) {
                el.textContent = money(compareAt * qty);
              });
            }
          }

          ['input', 'change'].forEach(function (evt) { qtyInput.addEventListener(evt, apply); });
          block.addEventListener('click', function (e) {
            if (e.target.closest('.quantity__button')) setTimeout(apply, 0);
          });

          // Dawn rewrites the price when the variant changes, which puts the
          // unit price back; reapply once it settles.
          var target = priceBlock.querySelector('[id^="price-"]');
          if (target && window.MutationObserver) {
            var busy = false;
            new MutationObserver(function () {
              if (busy) return;
              busy = true;
              setTimeout(function () { busy = false; apply(); }, 0);
            }).observe(target, { childList: true, subtree: true });
          }

          apply();
        })();
      </script>
      {%- endraw -%}

      {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank -%}
        <div class="pe-trust">
          {%- if section.settings.trust_1 != blank -%}
            <span><i></i>{{ section.settings.trust_1 | escape }}</span>
          {%- endif -%}
          {%- if section.settings.trust_2 != blank -%}
            <span><i></i>{{ section.settings.trust_2 | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
          

    {% render 'product-media-modal', variant_images: variant_images %}

    

    {% assign popups = section.blocks | where: 'type', 'popup' %}
    {%- for block in popups -%}
      <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
        <div
          role="dialog"
          aria-label="{{ block.settings.text }}"
          aria-modal="true"
          class="product-popup-modal__content"
          tabindex="-1"
        >
          <button
            id="ModalClose-{{ block.id }}"
            type="button"
            class="product-popup-modal__toggle"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          <div class="product-popup-modal__content-info">
            <h1 class="h2">{{ block.settings.page.title | escape }}</h1>
            {{ block.settings.page.content }}
          </div>
        </div>
      </modal-dialog>
    {%- endfor -%}

    {%- if product.media.size > 0 -%}
      <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if first_3d_model -%}
      <script type="application/json" id="ProductJSON-{{ product.id }}">
        {{ product.media | where: 'media_type', 'model' | json }}
      </script>
      <script src="{{ 'product-model.js' | asset_url }}" defer></script>
    {%- endif -%}

    {%- liquid
      if product.selected_or_first_available_variant.featured_media
        assign seo_media = product.selected_or_first_available_variant.featured_media
      else
        assign seo_media = product.featured_media
      endif
    -%}

  

    {% include 'alireviews_aggregateRating_structured_data' %}

  </div> {% comment %} This closes the page-width div {% endcomment %}

