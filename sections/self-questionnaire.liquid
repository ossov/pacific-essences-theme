<style>
  .pacific-essences-quiz {
    padding: var(--spacing-section-vertical, 60px) 0;
    background-color: var(--color-background, #ffffff);
    color: var(--color-foreground, #333333);
    text-align: center;
  }
  .paq__container {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 var(--spacing-page-horizontal, 20px);
  }
  .paq__screen--hidden {
    display: none !important;
  }
  .paq__heading {
    font-size: 2.6rem;
    font-weight: 700;
    margin-bottom: 10px;
    background: linear-gradient(90deg, rgb(33, 160, 244), rgb(237, 49, 247));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.2;
  }
  .paq__heading sup {
    font-size: 1rem;
  }
  .paq__subtitle {
    font-size: 1rem;
    color: #888;
    margin-bottom: 30px;
  }
  .paq__intro-body {
    max-width: 620px;
    margin: 0 auto 35px;
    text-align: left;
    line-height: 1.7;
  }
  .paq__intro-body p + p {
    margin-top: 14px;
  }
  .paq__button {
    display: inline-block;
    padding: 14px 36px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    border: 2px solid #43A6DB;
    background-color: #43A6DB;
    color: #ffffff;
    border-radius: 50px;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    text-decoration: none;
  }
  .paq__button:hover {
    background-color: #ffffff;
    color: #43A6DB;
    border-color: #43A6DB;
  }
  .paq__button:focus {
    outline: none !important;
    box-shadow: none !important;
  }
  .paq__button--ghost {
    background-color: transparent;
    color: #43A6DB;
    border-color: #43A6DB;
  }
  .paq__button--ghost:hover {
    background-color: #43A6DB;
    color: #ffffff;
  }
  .paq__quiz-note {
    font-size: 0.95rem;
    color: #888;
    margin-bottom: 30px;
    font-style: italic;
  }
  .paq__questions-list {
    text-align: left;
    margin-bottom: 40px;
  }
  .paq__question {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 18px;
    cursor: pointer;
    border-radius: 8px;
    transition: background-color 0.15s ease;
    line-height: 1.55;
  }
  .paq__question:nth-child(even) {
    background-color: #f7f9fc;
  }
  .paq__question:hover {
    background-color: #edf4fb;
  }
  .paq__question input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    min-width: 22px;
    border: 2px solid #ccc;
    border-radius: 5px;
    cursor: pointer;
    margin-top: 1px;
    position: relative;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .paq__question input[type="checkbox"]:checked {
    background-color: #43A6DB;
    border-color: #43A6DB;
  }
  .paq__question input[type="checkbox"]:checked::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 2px;
    width: 7px;
    height: 11px;
    border: 2px solid #fff;
    border-top: none;
    border-left: none;
    transform: rotate(45deg);
  }
  .paq__question-text {
    font-size: 0.97rem;
    color: #333;
  }
  .paq__submit-area {
    padding-top: 10px;
  }
  .paq__result-label {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #aaa;
    margin-bottom: 10px;
  }
  .paq__result-inner {
    margin-bottom: 36px;
  }
  .paq__essence-number {
    font-size: 0.95rem;
    color: #aaa;
    margin-bottom: 4px;
  }
  .paq__essence-name {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: #222;
  }
  .paq__affirmation {
    font-size: 1.05rem;
    font-style: italic;
    color: #555;
    margin-bottom: 30px;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }
  .paq__product-card {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    overflow: hidden;
    max-width: 280px;
    width: 100%;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .paq__product-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,0.14);
    transform: translateY(-3px);
  }
  .paq__product-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }
  .paq__product-info {
    padding: 16px;
    width: 100%;
    box-sizing: border-box;
  }
  .paq__product-title {
    display: block;
    font-weight: 600;
    font-size: 0.98rem;
    margin-bottom: 6px;
    color: #222;
  }
  .paq__product-price {
    display: block;
    color: #43A6DB;
    font-weight: 700;
    font-size: 1rem;
  }
  .paq__product-cta {
    display: block;
    margin-top: 8px;
    font-size: 0.85rem;
    color: #888;
  }
  .paq__no-results {
    font-size: 1rem;
    color: #666;
    line-height: 1.6;
  }
  @media (max-width: 600px) {
    .paq__heading {
      font-size: 2rem;
    }
    .paq__question {
      padding: 12px 12px;
    }
  }
</style>

