    17: { name: "Metal",                       affirmation: "I let go of all limiting thoughts and feelings." },
    18: { name: "Wood",                        affirmation: "I am living my purpose." },
    19: { name: "Detox",                       affirmation: "I am clear and filled with light." },
    20: { name: "Super Vitality",              affirmation: "I am strong and full of energy." },
    21: { name: "Forgiving",                   affirmation: "I am free from all thoughts and feelings that prevent me from being who I can be." },
    22: { name: "Shielding",                   affirmation: "I am protected from all harmful energies." },
    23: { name: "Twelve Gems",                 affirmation: "I trust my inner knowing." },
    24: { name: "Essence of Success",          affirmation: "I enjoy every moment of this precious life." },
    25: { name: "Infinite Potential",          affirmation: "I am able to find guidance in stillness." },
    26: { name: "A New World of Hope (Ibuki)", affirmation: "I am living my heart song and inspire others to do the same." }
  };

  class PacificEssencesQuiz extends HTMLElement {
    connectedCallback() {
      this.sid = this.dataset.sectionId;
      this.introScreen  = this.querySelector(`#PAQIntro-${this.sid}`);
      this.quizScreen   = this.querySelector(`#PAQQuiz-${this.sid}`);
      this.resultScreen = this.querySelector(`#PAQResult-${this.sid}`);
      this.questionsEl  = this.querySelector(`#PAQQuestions-${this.sid}`);
      this.resultInner  = this.querySelector(`#PAQResultInner-${this.sid}`);

      const dataEl = document.getElementById(`PAQShopifyData-${this.sid}`);
      this.shopifyProducts = dataEl ? JSON.parse(dataEl.textContent) : {};

      this.querySelector(`#PAQStartBtn-${this.sid}`).addEventListener('click', () => this.showQuiz());
      this.querySelector(`#PAQSubmitBtn-${this.sid}`).addEventListener('click', () => this.calculateResult());
      this.querySelector(`#PAQRetryBtn-${this.sid}`).addEventListener('click', () => this.reset());

      this.renderQuestions();
    }

    renderQuestions() {
      this.questionsEl.innerHTML = PAQ_QUESTIONS.map((q, i) => `
        <label class="paq__question">
          <input type="checkbox" class="paq__checkbox" data-essence="${q.essence}" id="paq-q${i}-${this.sid}">
          <span class="paq__question-text">${q.text}</span>
        </label>
      `).join('');
    }

    scrollToTop() {
      const top = this.getBoundingClientRect().top + window.scrollY - 80;
      window.scrollTo({ top, behavior: 'smooth' });
    }

    showQuiz() {
      this.introScreen.classList.add('paq__screen--hidden');
      this.quizScreen.classList.remove('paq__screen--hidden');
      this.scrollToTop();
    }

    calculateResult() {
      const scores = {};
      for (let i = 1; i <= 26; i++) scores[i] = 0;

      this.querySelectorAll('.paq__checkbox:checked').forEach(cb => {
        scores[parseInt(cb.dataset.essence)]++;
      });

      let maxScore = 0;
      let winnerId = 1;
      for (let i = 1; i <= 26; i++) {
        if (scores[i] > maxScore) {
          maxScore = scores[i];
          winnerId = i;
        }
      }

      this.showResult(winnerId, maxScore);
    }

    showResult(id, score) {
      const essence  = PAQ_ESSENCES[id];
      const shopify  = this.shopifyProducts[String(id)];

      let html = '';

      if (score === 0) {
        html = `<p class="paq__no-results">You didn’t check any statements — you may be in a wonderful state of balance! Explore our full range of Pacific Essences to find what resonates with you.</p>`;
      } else {
        html += `
          <p class="paq__essence-number">Essence #${id}</p>
          <h3 class="paq__essence-name">${essence.name}</h3>
          <p class="paq__affirmation">“${essence.affirmation}”</p>
        `;

        if (shopify) {
          html += `
            <a href="${shopify.url}" class="paq__product-card">
              ${shopify.image ? `<img src="${shopify.image}" alt="${essence.name}" class="paq__product-image" loading="lazy">` : ''}
              <div class="paq__product-info">
                <span class="paq__product-title">${shopify.title}</span>
                <span class="paq__product-price">${shopify.price}</span>
                <span class="paq__product-cta">Tap to view product &rarr;</span>
              </div>
            </a>
          `;
        }
      }

      this.resultInner.innerHTML = html;
      this.quizScreen.classList.add('paq__screen--hidden');
      this.resultScreen.classList.remove('paq__screen--hidden');
      this.scrollToTop();
    }

    reset() {
      this.querySelectorAll('.paq__checkbox').forEach(cb => cb.checked = false);
      this.resultScreen.classList.add('paq__screen--hidden');
      this.introScreen.classList.remove('paq__screen--hidden');
      this.scrollToTop();
    }
  }

  if (!customElements.get('pacific-essences-quiz')) {
    customElements.define('pacific-essences-quiz', PacificEssencesQuiz);
  }
})();
</script>

