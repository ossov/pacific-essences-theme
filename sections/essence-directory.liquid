{%- comment -%}
  A directory of people or places.

  Serves both the distributors and the facilitators, because they are the same
  thing twice: a picture, a name, where they are, and ways to get in touch. One
  section, two templates, so a change to either page changes both.

  Logos and portraits behave differently and the block says which. A logo is
  artwork on a white ground, so it is fitted whole and its white is blended
  away; a portrait is a photograph, so it is cropped to a circle.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  {% style %}
    #ed-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
    #ed-{{ section.id }} .ed-inner { max-width: 100rem; margin: 0 auto; }

    #ed-{{ section.id }} .ed-head { margin: 0 0 1.6rem; text-align: center; }
    #ed-{{ section.id }} .ed-title {
      margin: 0;
      font-size: clamp(2.4rem, 1.9rem + 1vw, 3.2rem);
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.015em;
      color: {{ section.settings.heading_color }};
      text-wrap: balance;
    }
    #ed-{{ section.id }} .ed-intro {
      max-width: 72ch;
      margin: 1.2rem auto 0;
      font-size: 1.6rem;
      line-height: 1.65;
      color: {{ section.settings.text_color }};
    }
    #ed-{{ section.id }} .ed-banner {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 0 auto 2rem;
    }

    #ed-{{ section.id }} .ed-grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
      gap: 3.4rem 2.6rem;
      margin-top: 3.4rem;
    }
    #ed-{{ section.id }} .ed-card { display: flex; flex-direction: column; }

    /* Logos: fitted whole, never cropped, and their white ground blended into
       the page so they do not each sit on a slab of a slightly different white. */
    #ed-{{ section.id }} .ed-logo {
      display: flex;
      align-items: center;
      height: {{ section.settings.logo_height }}px;
      margin-bottom: 1.2rem;
    }
    #ed-{{ section.id }} .ed-logo img {
      max-height: 100%;
      max-width: 100%;
      width: auto;
      height: auto;
      mix-blend-mode: multiply;
    }

    /* Portraits: photographs, so cropped square and rounded. */
    #ed-{{ section.id }} .ed-face {
      width: {{ section.settings.face_size }}px;
      height: {{ section.settings.face_size }}px;
      border-radius: 50%;
      overflow: hidden;
      background: {{ section.settings.rule_color }};
      margin-bottom: 1.2rem;
    }
    #ed-{{ section.id }} .ed-face img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #ed-{{ section.id }} .ed-eyebrow {
      font-size: 1.1rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: {{ section.settings.muted_color }};
    }
    #ed-{{ section.id }} .ed-name {
      margin: 0.2rem 0 0;
      font-size: 1.8rem;
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -0.005em;
      color: {{ section.settings.name_color }};
    }
    #ed-{{ section.id }} .ed-place {
      margin: 0.3rem 0 0;
      font-size: 1.45rem;
      color: {{ section.settings.muted_color }};
    }
    #ed-{{ section.id }} .ed-bio {
      margin: 0.8rem 0 0;
      font-size: 1.45rem;
      line-height: 1.6;
      color: {{ section.settings.text_color }};
    }

    #ed-{{ section.id }} .ed-links {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      margin-top: 1.2rem;
      padding-top: 1.2rem;
      border-top: 1px solid {{ section.settings.rule_color }};
      font-size: 1.45rem;
    }
    #ed-{{ section.id }} .ed-links a {
      color: {{ section.settings.link_color }};
      font-weight: 600;
      text-decoration: none;
      overflow-wrap: anywhere;
    }
    #ed-{{ section.id }} .ed-links a:hover { text-decoration: underline; }
    #ed-{{ section.id }} .ed-links span { color: {{ section.settings.muted_color }}; }

    @media screen and (max-width: 989px) {
      #ed-{{ section.id }} .ed-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media screen and (max-width: 599px) {
      #ed-{{ section.id }} .ed-grid { grid-template-columns: 1fr; gap: 2.8rem; }
    }
  {% endstyle %}

  <div id="ed-{{ section.id }}" class="ed-section color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width">
      <div class="ed-inner">
        {%- if section.settings.banner -%}
          {{
            section.settings.banner
            | image_url: width: 1400
            | image_tag: class: 'ed-banner', loading: 'eager', widths: '700, 1000, 1400', alt: ''
          }}
        {%- endif -%}

        {%- if section.settings.heading != blank or section.settings.intro != blank -%}
          <div class="ed-head">
            {%- if section.settings.heading != blank -%}
              <h1 class="ed-title">{{ section.settings.heading | escape }}</h1>
            {%- endif -%}
            {%- if section.settings.intro != blank -%}
              <p class="ed-intro">{{ section.settings.intro }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="ed-grid">
          {%- for block in section.blocks -%}
            {%- liquid
              # Some of these pictures live in Files under names the image
              # picker cannot resolve, so a block may carry a plain URL
              # instead. The picker wins where both are set.
              assign pic = block.settings.image
              assign pic_url = ''
              if pic
                assign pic_url = pic | image_url: width: 480
              elsif block.settings.image_url != blank
                assign pic_url = block.settings.image_url
              endif
            -%}
            <div class="ed-card" {{ block.shopify_attributes }}>
              {%- if pic_url != blank -%}
                {%- if block.settings.style == 'portrait' -%}
                  <span class="ed-face">
                    <img src="{{ pic_url }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="400" height="400">
                  </span>
                {%- else -%}
                  <span class="ed-logo">
                    <img src="{{ pic_url }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                  </span>
                {%- endif -%}
              {%- endif -%}

              {%- if block.settings.eyebrow != blank -%}
                <span class="ed-eyebrow">{{ block.settings.eyebrow | escape }}</span>
              {%- endif -%}
              {%- if block.settings.name != blank -%}
                <h2 class="ed-name">{{ block.settings.name | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.place != blank -%}
                <p class="ed-place">{{ block.settings.place | escape }}</p>
              {%- endif -%}
              {%- if block.settings.bio != blank -%}
                <p class="ed-bio">{{ block.settings.bio | escape }}</p>
              {%- endif -%}

              {%- liquid
                assign any_link = false
                if block.settings.link_1_label != blank or block.settings.link_2_label != blank
                  assign any_link = true
                endif
                if block.settings.link_3_label != blank or block.settings.plain != blank
                  assign any_link = true
                endif
              -%}
              {%- if any_link -%}
                <div class="ed-links">
                  {%- for i in (1..3) -%}
                    {%- liquid
                      case i
                        when 1
                          assign lbl = block.settings.link_1_label
                          assign url = block.settings.link_1_url
                        when 2
                          assign lbl = block.settings.link_2_label
                          assign url = block.settings.link_2_url
                        when 3
                          assign lbl = block.settings.link_3_label
                          assign url = block.settings.link_3_url
                      endcase
                    -%}
                    {%- if lbl != blank -%}
                      {%- if url != blank -%}
                        <a href="{{ url }}">{{ lbl | escape }}</a>
                      {%- else -%}
                        <span>{{ lbl | escape }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if block.settings.plain != blank -%}
                    <span>{{ block.settings.plain | escape }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Directory",
  "tag": "section",
  "class": "section",
  "max_blocks": 50,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "image_picker", "id": "banner", "label": "Banner image" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "intro", "label": "Intro" },

    { "type": "header", "content": "Appearance" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "logo_height", "min": 48, "max": 160, "step": 4, "unit": "px", "label": "Logo height", "default": 84 },
    { "type": "range", "id": "face_size", "min": 56, "max": 160, "step": 4, "unit": "px", "label": "Portrait size", "default": 96 },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#2a87b9" },
    { "type": "color", "id": "link_color", "label": "Links", "default": "#2a87b9" },
    { "type": "color", "id": "name_color", "label": "Name", "default": "#123b51" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#4a6b7c" },
    { "type": "color", "id": "muted_color", "label": "Labels and place", "default": "#7c97a6" },
    { "type": "color", "id": "rule_color", "label": "Rules", "default": "#e7eff4" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },

    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Entry",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Picture" },
        {
          "type": "text",
          "id": "image_url",
          "label": "Picture URL",
          "info": "Only needed when the picker above cannot find the file. The picker wins if both are set."
        },
        {
          "type": "select",
          "id": "style",
          "label": "Picture style",
          "options": [
            { "value": "logo", "label": "Logo — fitted whole, white removed" },
            { "value": "portrait", "label": "Portrait — cropped to a circle" }
          ],
          "default": "logo"
        },
        { "type": "text", "id": "eyebrow", "label": "Label above the name", "info": "The country, on the distributors page." },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "place", "label": "Place" },
        { "type": "textarea", "id": "bio", "label": "Description" },
        { "type": "header", "content": "Ways to get in touch" },
        { "type": "text", "id": "link_1_label", "label": "First link text" },
        { "type": "url", "id": "link_1_url", "label": "First link" },
        { "type": "text", "id": "link_2_label", "label": "Second link text" },
        { "type": "url", "id": "link_2_url", "label": "Second link" },
        { "type": "text", "id": "link_3_label", "label": "Third link text" },
        { "type": "url", "id": "link_3_url", "label": "Third link" },
        { "type": "text", "id": "plain", "label": "Line with no link", "info": "A phone number, for instance." }
      ]
    }
  ],
  "presets": [{ "name": "Directory" }]
}
{% endschema %}
