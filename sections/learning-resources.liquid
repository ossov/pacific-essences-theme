{%- comment -%}
  Learning resources.

  One row per thing: the picture, what it is called, and a badge saying what
  kind of thing it is. The list shape is the point — it stays readable at six
  and it will still be readable at twenty, which a grid of cards would not.

  The thumbnails deliberately have no frame. These are cover art and logos of
  different shapes, and a fixed box around them puts a band of dead space down
  either side of every portrait book cover. A common height and a natural width
  lines them up without boxing them in.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  {% style %}
    #lr-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
    #lr-{{ section.id }} .lr-inner { max-width: 78rem; margin: 0 auto; }

    #lr-{{ section.id }} .lr-head { margin: 0 0 2.4rem; text-align: center; }
    #lr-{{ section.id }} .lr-eyebrow {
      margin: 0 0 0.8rem;
      font-size: 1.1rem;
      font-weight: 800;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: {{ section.settings.label_color }};
    }
    #lr-{{ section.id }} .lr-title {
      margin: 0;
      font-size: clamp(2.1rem, 1.7rem + 0.8vw, 2.8rem);
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.015em;
      color: {{ section.settings.heading_color }};
      text-wrap: balance;
    }

    #lr-{{ section.id }} .lr-group + .lr-group { margin-top: 3rem; }
    #lr-{{ section.id }} .lr-group-head {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      margin: 0 0 0.4rem;
      padding-bottom: 0.9rem;
      border-bottom: 2px solid {{ section.settings.label_color }};
    }
    #lr-{{ section.id }} .lr-group-name {
      margin: 0;
      font-size: 1.3rem;
      font-weight: 800;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: {{ section.settings.group_color }};
    }
    #lr-{{ section.id }} .lr-group-count {
      font-size: 1.3rem;
      color: {{ section.settings.muted_color }};
    }

    #lr-{{ section.id }} .lr-row {
      display: grid;
      grid-template-columns: {{ section.settings.thumb_height | plus: 14 }}px 1fr auto;
      gap: 2rem;
      align-items: center;
      padding: 1.6rem 0;
      border-top: 1px solid {{ section.settings.rule_color }};
      text-decoration: none;
      color: inherit;
    }
    #lr-{{ section.id }} .lr-group-head + .lr-row { border-top: 0; }

    /* No box. A common height, a natural width, centred in the column — so a
       tall book cover and a square logo line up without either being padded
       out to a shape it is not. */
    #lr-{{ section.id }} .lr-pic {
      display: flex;
      align-items: center;
      justify-content: center;
      height: {{ section.settings.thumb_height }}px;
    }
    #lr-{{ section.id }} .lr-pic img {
      display: block;
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      border-radius: 6px;
      transition: transform 0.18s ease;
      {%- if section.settings.drop_white %}
      /* The four book covers are portrait artwork saved into a square file,
         padded out with pure white down both sides — measured at 255,255,255
         on every one of them. No amount of fitting or cropping removes that,
         because it is in the picture. Multiplying drops white into whatever is
         behind it, so the padding disappears and the cover sits on the page.
         Only correct while the background behind is white or near it, which is
         why it is a setting rather than a given. */
      mix-blend-mode: multiply;
      {%- endif %}
    }
    #lr-{{ section.id }} .lr-row:hover .lr-pic img { transform: scale(1.05); }

    #lr-{{ section.id }} .lr-mid { min-width: 0; }
    #lr-{{ section.id }} .lr-name {
      display: block;
      font-size: 1.75rem;
      font-weight: 800;
      line-height: 1.3;
      color: {{ section.settings.name_color }};
    }
    #lr-{{ section.id }} .lr-row:hover .lr-name { color: {{ section.settings.label_color }}; }
    #lr-{{ section.id }} .lr-sub {
      display: block;
      margin-top: 0.2rem;
      font-size: 1.45rem;
      line-height: 1.5;
      color: {{ section.settings.muted_color }};
    }
    #lr-{{ section.id }} .lr-kind {
      font-size: 1.1rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: {{ section.settings.group_color }};
      background: {{ section.settings.badge_background }};
      border-radius: 999px;
      padding: 0.4rem 1.1rem;
      white-space: nowrap;
    }
    #lr-{{ section.id }} .lr-row:focus-visible {
      outline: 2px solid {{ section.settings.label_color }};
      outline-offset: 3px;
      border-radius: 8px;
    }

    @media screen and (max-width: 749px) {
      #lr-{{ section.id }} .lr-row {
        grid-template-columns: {{ section.settings.thumb_height | times: 0.75 | round | plus: 10 }}px 1fr;
        gap: 1.4rem;
      }
      #lr-{{ section.id }} .lr-pic { height: {{ section.settings.thumb_height | times: 0.75 | round }}px; }
      #lr-{{ section.id }} .lr-name { font-size: 1.6rem; }
      #lr-{{ section.id }} .lr-kind { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      #lr-{{ section.id }} .lr-pic img { transition: none; }
      #lr-{{ section.id }} .lr-row:hover .lr-pic img { transform: none; }
    }
  {% endstyle %}

  {%- liquid
    # How many rows sit under each group heading.
    assign counts = ''
    assign n = 0
    assign in_group = false
    for block in section.blocks
      if block.type == 'group'
        if in_group
          assign counts = counts | append: n | append: ','
        endif
        assign in_group = true
        assign n = 0
      elsif block.type == 'item'
        assign n = n | plus: 1
      endif
    endfor
    if in_group
      assign counts = counts | append: n | append: ','
    endif
    assign count_list = counts | split: ','

    # The thumbnail is capped by the column, and a filter argument cannot
    # interpolate, hence the capture.
    capture thumb_sizes
      echo section.settings.thumb_height | plus: 14
      echo 'px'
    endcapture
  -%}

  <div id="lr-{{ section.id }}" class="lr-section color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width">
      <div class="lr-inner">
        {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
          <div class="lr-head">
            {%- if section.settings.eyebrow != blank -%}
              <p class="lr-eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="lr-title">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- assign open_group = false -%}
        {%- assign gi = 0 -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'group' -%}
              {%- if open_group %}</div>{% endif -%}
              <div class="lr-group" {{ block.shopify_attributes }}>
                <div class="lr-group-head">
                  <h3 class="lr-group-name">{{ block.settings.heading | escape }}</h3>
                  {%- if block.settings.note != blank -%}
                    <span class="lr-group-count">{{ block.settings.note | escape }}</span>
                  {%- else -%}
                    <span class="lr-group-count">{{ count_list[gi] }}</span>
                  {%- endif -%}
                </div>
              {%- assign open_group = true -%}
              {%- assign gi = gi | plus: 1 -%}

            {%- when 'item' -%}
              {%- liquid
                # A resource can be pointed at a product instead of being typed
                # out. The four translated editions are products, so their
                # picture, name and link come from the product itself and stay
                # right if any of them is renamed or re-photographed.
                assign item = block.settings.product
                assign pic = block.settings.image
                assign name = block.settings.heading
                assign href = block.settings.link
                if item != blank
                  unless pic
                    assign pic = item.featured_image
                  endunless
                  if name == blank
                    assign name = item.title
                  endif
                  if href == blank
                    assign href = item.url
                  endif
                endif
                if href == blank
                  assign href = '#'
                endif
              -%}
              <a class="lr-row" href="{{ href }}" {{ block.shopify_attributes }}>
                <span class="lr-pic">
                  {%- if pic -%}
                    {{
                      pic
                      | image_url: width: 300
                      | image_tag:
                        loading: 'lazy',
                        sizes: thumb_sizes,
                        widths: '150, 220, 300',
                        alt: name
                    }}
                  {%- endif -%}
                </span>
                <span class="lr-mid">
                  <span class="lr-name">{{ name | escape }}</span>
                  {%- if block.settings.subtitle != blank -%}
                    <span class="lr-sub">{{ block.settings.subtitle | escape }}</span>
                  {%- endif -%}
                </span>
                {%- if block.settings.kind != blank -%}
                  <span class="lr-kind">{{ block.settings.kind | escape }}</span>
                {%- endif -%}
              </a>
          {%- endcase -%}
        {%- endfor -%}
        {%- if open_group %}</div>{% endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Learning resources",
  "tag": "section",
  "class": "section",
  "max_blocks": 40,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },

    { "type": "header", "content": "Appearance" },
    {
      "type": "range",
      "id": "thumb_height",
      "min": 48,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Picture height",
      "default": 88,
      "info": "Every picture is set to this height and keeps its own width, so nothing is boxed or cropped."
    },
    {
      "type": "checkbox",
      "id": "drop_white",
      "label": "Drop the white padding around pictures",
      "default": true,
      "info": "Blends white away so cover art does not sit on a white slab. Turn off if the background behind is not white."
    },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#2a87b9" },
    { "type": "color", "id": "label_color", "label": "Accent and hover", "default": "#2a87b9" },
    { "type": "color", "id": "group_color", "label": "Group name and badge text", "default": "#1c5b7d" },
    { "type": "color", "id": "name_color", "label": "Name", "default": "#123b51" },
    { "type": "color", "id": "muted_color", "label": "Subtitle and count", "default": "#7c97a6" },
    { "type": "color", "id": "rule_color", "label": "Rule between rows", "default": "#e7eff4" },
    { "type": "color", "id": "badge_background", "label": "Behind the badge", "default": "#eaf3f8" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },

    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Group heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Group name" },
        { "type": "text", "id": "note", "label": "Note beside it", "info": "Leave empty to show the number of items." },
        { "type": "paragraph", "content": "Every item below this heading belongs to it, until the next group heading." }
      ]
    },
    {
      "type": "item",
      "name": "Resource",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Optional. Fills in the picture, name and link from the product; anything set below wins."
        },
        { "type": "image_picker", "id": "image", "label": "Picture" },
        { "type": "text", "id": "heading", "label": "Name" },
        { "type": "text", "id": "subtitle", "label": "Line underneath" },
        { "type": "text", "id": "kind", "label": "Badge" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Learning resources" }]
}
{% endschema %}
