{%- comment -%}
  Essence energetics — the metafield content that used to sit collapsed inside
  the "More About This Product" accordion.

  Every field gets its own box in a three-up grid. Boxes only exist for fields
  the product actually carries, so a product with four of them looks as
  deliberate as one with twelve, and a product with none renders no band at all
  rather than an empty coloured strip. Individual essences carry a different set
  from combinations, and plenty of products carry almost none.
{%- endcomment -%}

{%- liquid
  assign m = product.metafields.custom

  # has_boxes gates the heading, because the TCM heading over a product that
  # only carries a plain description reads as a mislabel. The kit products are
  # exactly this case: prose, no energetics.
  assign has_boxes = false
  if m.resonance != blank or m.key_attractors != blank or m.key_challenges != blank
    assign has_boxes = true
  elsif m.mental != blank or m.emotional != blank or m.physical != blank or m.spiritual != blank
    assign has_boxes = true
  elsif m.meridians != blank or m.chakras != blank or m.essence_type != blank
    assign has_boxes = true
  elsif m.essence_new != blank or m.ingredients != blank or m.directions != blank
    assign has_boxes = true
  endif

  assign has_content = has_boxes
  if m.simple_accordion_rich != blank
    assign has_content = true
  endif
-%}

{%- if has_content -%}
  {% style %}
    #ee-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      border-top: 1px solid {{ section.settings.box_border }};
      border-bottom: 1px solid {{ section.settings.box_border }};
    }

    #ee-{{ section.id }} .ee-eyebrow {
      margin: 0 0 8px;
      font-size: 1.1rem;
      font-weight: 800;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: {{ section.settings.label_color }};
    }

    #ee-{{ section.id }} .ee-title {
      margin: 0 0 22px;
      font-size: clamp(2.1rem, 1.6rem + 0.8vw, 2.6rem);
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.015em;
      color: {{ section.settings.heading_color }};
      text-wrap: balance;
    }

    #ee-{{ section.id }} .ee-intro {
      font-size: 1.6rem;
      line-height: 1.65;
      max-width: 62ch;
      margin: 0 0 22px;
      color: {{ section.settings.value_color }};
    }
    #ee-{{ section.id }} .ee-intro > :first-child { margin-top: 0; }
    #ee-{{ section.id }} .ee-intro > :last-child { margin-bottom: 0; }

    /* One box per field. Boxes only exist for fields the product carries, so
       the grid fills itself and never leaves a hole. */
    #ee-{{ section.id }} .ee-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      align-items: start;
    }

    #ee-{{ section.id }} .ee-box {
      background: {{ section.settings.box_background }};
      border: 1px solid {{ section.settings.box_border }};
      border-radius: {{ section.settings.box_radius }}px;
      padding: 18px;
      min-width: 0;
    }

    /* Prose runs longer than a label/value pair, so it takes two columns. */
    #ee-{{ section.id }} .ee-box--wide { grid-column: span 2; }

    #ee-{{ section.id }} .ee-box h3 {
      margin: 0 0 5px;
      font-size: 1.1rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: {{ section.settings.label_color }};
      overflow-wrap: anywhere;
    }

    #ee-{{ section.id }} .ee-box .ee-val {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 600;
      line-height: 1.5;
      color: {{ section.settings.value_color }};
      overflow-wrap: anywhere;
    }
    #ee-{{ section.id }} .ee-box .ee-val > :first-child { margin-top: 0; }
    #ee-{{ section.id }} .ee-box .ee-val > :last-child { margin-bottom: 0; }
    #ee-{{ section.id }} .ee-box .ee-val p { margin: 0 0 .4em; }

    #ee-{{ section.id }} .ee-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 8px;
    }

    #ee-{{ section.id }} .ee-chip {
      border-radius: {{ section.settings.chip_radius }}px;
      padding: 6px 13px;
      font-size: 1.3rem;
      font-weight: 700;
      line-height: 1.35;
      background: {{ section.settings.chip_background }};
      color: {{ section.settings.chip_text }};
    }

    @media screen and (max-width: 989px) {
      #ee-{{ section.id }} .ee-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media screen and (max-width: 749px) {
      #ee-{{ section.id }} .ee-grid { grid-template-columns: 1fr; }
      #ee-{{ section.id }} .ee-box--wide { grid-column: span 1; }
    }
  {% endstyle %}

  <div id="ee-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width">
      {%- if has_boxes and section.settings.eyebrow != blank -%}
        <p class="ee-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if has_boxes and section.settings.heading != blank -%}
        <h2 class="ee-title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- comment -%}
        The old accordion opened with this rich text block on products that have
        it, so it is carried over rather than dropped.
      {%- endcomment -%}
      {%- if m.simple_accordion_rich != blank -%}
        <div class="ee-intro rte">{{ m.simple_accordion_rich | metafield_tag }}</div>
      {%- endif -%}

      {%- comment -%}
        One box per field. Each is conditional, so a product showing four of
        these looks as deliberate as one showing twelve.
      {%- endcomment -%}
      <div class="ee-grid">

        {%- if m.essence_new != blank -%}
          <div class="ee-box"><h3>Essence</h3><div class="ee-val rte">{{ m.essence_new | metafield_tag }}</div></div>
        {%- endif -%}

        {%- if m.resonance != blank -%}
          <div class="ee-box"><h3>Resonance</h3><div class="ee-val rte">{{ m.resonance | metafield_tag }}</div></div>
        {%- endif -%}

        {%- if m.essence_type != blank -%}
          <div class="ee-box"><h3>Essence type</h3><div class="ee-val rte">{{ m.essence_type | metafield_tag }}</div></div>
        {%- endif -%}

        {%- comment -%}
          Attractors and challenges are plain comma-separated text, which is why
          these two become chips. A value with no commas is simply one chip.
        {%- endcomment -%}
        {%- if m.key_attractors != blank -%}
          <div class="ee-box">
            <h3>Key attractors</h3>
            <div class="ee-chips">
              {%- assign attractors = m.key_attractors | split: ',' -%}
              {%- for item in attractors -%}
                {%- assign clean = item | strip -%}
                {%- if clean != blank -%}<span class="ee-chip">{{ clean }}</span>{%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if m.key_challenges != blank -%}
          <div class="ee-box">
            <h3>Key challenges</h3>
            <div class="ee-chips">
              {%- assign challenges = m.key_challenges | split: ',' -%}
              {%- for item in challenges -%}
                {%- assign clean = item | strip -%}
                {%- if clean != blank -%}<span class="ee-chip">{{ clean }}</span>{%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if m.mental != blank -%}
          <div class="ee-box"><h3>Mental</h3><div class="ee-val rte">{{ m.mental | metafield_tag }}</div></div>
        {%- endif -%}
        {%- if m.emotional != blank -%}
          <div class="ee-box"><h3>Emotional</h3><div class="ee-val rte">{{ m.emotional | metafield_tag }}</div></div>
        {%- endif -%}
        {%- if m.physical != blank -%}
          <div class="ee-box"><h3>Physical</h3><div class="ee-val rte">{{ m.physical | metafield_tag }}</div></div>
        {%- endif -%}
        {%- if m.spiritual != blank -%}
          <div class="ee-box"><h3>Spiritual</h3><div class="ee-val rte">{{ m.spiritual | metafield_tag }}</div></div>
        {%- endif -%}

        {%- if m.meridians != blank -%}
          <div class="ee-box"><h3>Meridians</h3><div class="ee-val rte">{{ m.meridians | metafield_tag }}</div></div>
        {%- endif -%}
        {%- if m.chakras != blank -%}
          <div class="ee-box"><h3>Chakras</h3><div class="ee-val rte">{{ m.chakras | metafield_tag }}</div></div>
        {%- endif -%}
        {%- if m.ingredients != blank -%}
          <div class="ee-box"><h3>Ingredients</h3><div class="ee-val rte">{{ m.ingredients | metafield_tag }}</div></div>
        {%- endif -%}

        {%- if m.directions != blank -%}
          <div class="ee-box ee-box--wide">
            <h3>{{ section.settings.directions_label | escape }}</h3>
            <div class="ee-val rte">{{ m.directions | metafield_tag }}</div>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Essence energetics",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Each metafield gets its own box. Boxes appear only for fields the product has, so nothing is left empty."
    },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Signs & symptoms" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Based on the energetics of Traditional Chinese Medicine" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#2a87b9" },
    { "type": "color", "id": "label_color", "label": "Eyebrow and box label colour", "default": "#43a6db" },

    { "type": "header", "content": "Boxes" },
    { "type": "color", "id": "box_background", "label": "Box background", "default": "#ffffff" },
    { "type": "color", "id": "box_border", "label": "Box border", "default": "#e7eff4" },
    { "type": "color", "id": "value_color", "label": "Box text colour", "default": "#33586b" },
    { "type": "range", "id": "box_radius", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Box corner radius", "default": 14 },
    { "type": "text", "id": "directions_label", "label": "Directions box heading", "default": "How to take it" },

    { "type": "header", "content": "Chips" },
    { "type": "paragraph", "content": "Used for key attractors and key challenges, which are comma-separated lists." },
    { "type": "color", "id": "chip_background", "label": "Chip background", "default": "#eaf3f8" },
    { "type": "color", "id": "chip_text", "label": "Chip text", "default": "#1d6a94" },
    { "type": "range", "id": "chip_radius", "min": 0, "max": 50, "step": 2, "unit": "px", "label": "Chip corner radius", "default": 50 },

    { "type": "header", "content": "Section style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-tide" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
  ],
  "presets": [{ "name": "Essence energetics" }]
}
{% endschema %}
