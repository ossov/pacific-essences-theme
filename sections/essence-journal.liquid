{%- comment -%}
  The journal.

  Dawn's featured blog puts three equal columns under a left-aligned heading,
  which on this homepage sat on white directly under another white section and
  read as more of the same. This is the same posts in an editorial shape: the
  newest one leads, the next three stack beside it, and the stack divides the
  lead's height so the bottom-right corner fills instead of trailing off.
{%- endcomment -%}

{%- liquid
  assign blog = section.settings.blog
  assign posts = blog.articles
  assign total = section.settings.post_limit | plus: 0
  # limit: does not take a filter expression, so the stack count is worked out here
  assign stack_count = total | minus: 1
  assign has_posts = false
  if posts.size > 0
    assign has_posts = true
  endif
-%}

{%- if has_posts -%}
  {% style %}
    #ej-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      border-top: 1px solid {{ section.settings.card_border }};
      border-bottom: 1px solid {{ section.settings.card_border }};
    }

    /* The heading is centred here, unlike the product page bands — this one
       sits between two full-width sections and reads better as a title over
       the grid than as a label beside it. */
    #ej-{{ section.id }} .ej-head {
      max-width: 62ch;
      margin: 0 auto 30px;
      text-align: center;
    }
    #ej-{{ section.id }} .ej-eyebrow {
      margin: 0 0 8px;
      font-size: 1.1rem;
      font-weight: 800;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: {{ section.settings.label_color }};
    }
    #ej-{{ section.id }} .ej-title {
      margin: 0;
      font-size: clamp(2.1rem, 1.6rem + 0.8vw, 2.8rem);
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.015em;
      color: {{ section.settings.heading_color }};
      text-wrap: balance;
    }
    #ej-{{ section.id }} .ej-intro {
      margin: 10px 0 0;
      font-size: 1.6rem;
      line-height: 1.6;
      color: {{ section.settings.value_color }};
    }

    #ej-{{ section.id }} .ej-grid {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 22px;
      align-items: stretch;
    }
    /* Three equal rows filling exactly the height of the lead, so there is no
       gap left in the corner. */
    #ej-{{ section.id }} .ej-stack {
      display: grid;
      grid-template-rows: repeat({{ stack_count }}, 1fr);
      gap: 22px;
      min-height: 0;
    }

    #ej-{{ section.id }} .ej-card {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      min-height: 0;
      background: {{ section.settings.card_background }};
      border: 1px solid {{ section.settings.card_border }};
      border-radius: {{ section.settings.card_radius }}px;
      text-decoration: none;
      color: inherit;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    #ej-{{ section.id }} .ej-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 32px rgba(18, 48, 63, 0.1);
    }
    #ej-{{ section.id }} .ej-card:focus-visible {
      outline: 2px solid {{ section.settings.heading_color }};
      outline-offset: 3px;
    }

    #ej-{{ section.id }} .ej-card__media {
      display: block;
      overflow: hidden;
      background: #eef6fa;
      min-height: 0;
    }
    #ej-{{ section.id }} .ej-card__media img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }
    /* The lead is as tall as the three beside it, but its picture was a fixed
       16:9 and its text is short, so at some widths the content stopped up to
       94px above the bottom of the card and the left column read as shorter.
       The picture takes whatever height is left instead. */
    #ej-{{ section.id }} .ej-lead .ej-card__media {
      flex: 1 1 auto;
      min-height: 22rem;
    }

    #ej-{{ section.id }} .ej-card__body {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 16px 20px 20px;
      min-height: 0;
    }
    #ej-{{ section.id }} .ej-date {
      font-size: 1.1rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: {{ section.settings.label_color }};
    }
    #ej-{{ section.id }} .ej-card h3 {
      margin: 0;
      font-size: 1.7rem;
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -0.01em;
      color: {{ section.settings.heading_color }};
    }
    #ej-{{ section.id }} .ej-lead h3 { font-size: 2.2rem; }
    #ej-{{ section.id }} .ej-card p {
      margin: 0;
      font-size: 1.35rem;
      line-height: 1.55;
      color: {{ section.settings.value_color }};
      /* Long excerpts must not push the row taller than its share. */
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    #ej-{{ section.id }} .ej-lead p { -webkit-line-clamp: 4; }

    /* The stacked ones read across rather than down. */
    #ej-{{ section.id }} .ej-stack .ej-card { flex-direction: row; }
    #ej-{{ section.id }} .ej-stack .ej-card__media { flex: 0 0 38%; }
    #ej-{{ section.id }} .ej-stack .ej-card__body {
      flex: 1;
      justify-content: center;
      gap: 4px;
      padding: 14px 18px;
    }
    #ej-{{ section.id }} .ej-stack .ej-card p { -webkit-line-clamp: 2; }

    #ej-{{ section.id }} .ej-foot { margin-top: 28px; text-align: center; }
    #ej-{{ section.id }} .ej-more {
      display: inline-flex;
      align-items: center;
      height: 4.6rem;
      padding: 0 2.8rem;
      border-radius: 999px;
      font-size: 1.45rem;
      font-weight: 800;
      text-decoration: none;
      color: {{ section.settings.heading_color }};
      box-shadow: inset 0 0 0 1.6px {{ section.settings.heading_color }}73;
      transition: background 0.2s ease, box-shadow 0.2s ease;
    }
    #ej-{{ section.id }} .ej-more:hover {
      background: {{ section.settings.heading_color }}0f;
      box-shadow: inset 0 0 0 1.6px {{ section.settings.heading_color }};
    }

    @media screen and (max-width: 989px) {
      #ej-{{ section.id }} .ej-grid { grid-template-columns: minmax(0, 1fr); }
      #ej-{{ section.id }} .ej-stack { grid-template-rows: none; }
      #ej-{{ section.id }} .ej-lead .ej-card__media {
        flex: none;
        aspect-ratio: 16 / 9;
        min-height: 0;
      }
    }
    @media screen and (max-width: 560px) {
      #ej-{{ section.id }} .ej-stack .ej-card { flex-direction: column; }
      #ej-{{ section.id }} .ej-stack .ej-card__media { flex: none; aspect-ratio: 16 / 9; }
      #ej-{{ section.id }} .ej-stack .ej-card__body { justify-content: flex-start; }
    }
    @media (prefers-reduced-motion: reduce) {
      #ej-{{ section.id }} .ej-card { transition: none; }
    }
  {% endstyle %}

  <div id="ej-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width">

      <div class="ej-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ej-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ej-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="ej-intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </div>

      <div class="ej-grid">
        {%- for article in posts limit: 1 -%}
          <a class="ej-card ej-lead" href="{{ article.url }}">
            {%- if article.image -%}
              <span class="ej-card__media">
                {{ article.image | image_url: width: 1100 | image_tag:
                   loading: 'lazy',
                   sizes: '(min-width: 990px) 620px, 100vw',
                   widths: '400, 620, 900, 1100',
                   alt: article.image.alt | default: article.title | escape }}
              </span>
            {%- endif -%}
            <span class="ej-card__body">
              {%- if section.settings.show_date -%}
                <span class="ej-date">{{ article.published_at | time_tag: format: 'date' }}</span>
              {%- endif -%}
              <h3>{{ article.title | escape }}</h3>
              {%- if section.settings.show_excerpt -%}
                <p>{{ article.excerpt_or_content | strip_html | truncatewords: 34 }}</p>
              {%- endif -%}
            </span>
          </a>
        {%- endfor -%}

        <div class="ej-stack">
          {%- for article in posts offset: 1 limit: stack_count -%}
            <a class="ej-card" href="{{ article.url }}">
              {%- if article.image -%}
                <span class="ej-card__media">
                  {{ article.image | image_url: width: 600 | image_tag:
                     loading: 'lazy',
                     sizes: '(min-width: 990px) 200px, 40vw',
                     widths: '200, 400, 600',
                     alt: article.image.alt | default: article.title | escape }}
                </span>
              {%- endif -%}
              <span class="ej-card__body">
                {%- if section.settings.show_date -%}
                  <span class="ej-date">{{ article.published_at | time_tag: format: 'date' }}</span>
                {%- endif -%}
                <h3>{{ article.title | escape }}</h3>
                {%- if section.settings.show_excerpt -%}
                  <p>{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
                {%- endif -%}
              </span>
            </a>
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.show_view_all and blog.url != blank -%}
        <div class="ej-foot">
          <a class="ej-more" href="{{ blog.url }}">{{ section.settings.view_all_label | escape }}</a>
        </div>
      {%- endif -%}

    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Journal",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    {
      "type": "range",
      "id": "post_limit",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Posts",
      "default": 4,
      "info": "One leads, the rest stack beside it."
    },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wisdom from Pacific Essences" },
    { "type": "text", "id": "intro", "label": "Intro line" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#2a87b9" },
    { "type": "color", "id": "label_color", "label": "Eyebrow and date colour", "default": "#43a6db" },

    { "type": "header", "content": "Cards" },
    { "type": "checkbox", "id": "show_date", "label": "Show the date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show an excerpt", "default": true },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#e7eff4" },
    { "type": "color", "id": "value_color", "label": "Excerpt colour", "default": "#33586b" },
    { "type": "range", "id": "card_radius", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Card corner radius", "default": 14 },

    { "type": "header", "content": "Link" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show the link to the blog", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Link label", "default": "Read all" },

    { "type": "header", "content": "Section style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-tide" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
  ],
  "presets": [{ "name": "Journal" }]
}
{% endschema %}
