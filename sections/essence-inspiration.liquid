{%- comment -%}
  Your Daily Essence Inspiration.

  Draws one essence at random and shows the square graphic that already lives on
  its product page — the one with the words set into the picture, which the
  product gallery no longer uses since it shows the bottle and the plant.

  Where the pool comes from, and why it is fetched rather than rendered:
  Liquid caps collection.products at 50 items per loop and `offset` does not get
  past it — measured, a five-pass loop over a 143-product collection returned 50.
  So the list is fetched from the collection's own products.json, which returns
  all of them in about 21KB. That happens on load, a graphic is chosen straight
  away and put into the hidden face of the card, so the flip reveals a picture
  that is already downloaded and painted.

  A product joins the pool by being in the chosen collection AND having an image
  whose filename contains "IG". That is a naming convention rather than data,
  the same fragility that lost the Lakshmi photograph when the Goddess range was
  renamed. It holds for all 143 today; a metafield would make it durable.
{%- endcomment -%}

{%- liquid
  assign pool = section.settings.collection | default: collections['individual-essences']
-%}

{% style %}
  #ei-{{ section.id }} {
    /* A custom element is inline until told otherwise, so the band painted only
       behind the text instead of across the section. */
    display: block;
    background: linear-gradient(160deg, {{ section.settings.band_from }} 0%, {{ section.settings.band_to }} 100%);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #ei-{{ section.id }} .ins-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
    max-width: 100rem;
    margin: 0 auto;
  }

  /* A fixed square, so nothing on the page moves when the picture arrives.
     A span is inline, and width and aspect-ratio do not apply to inline
     elements — without display:block the frame collapses to nothing. */
  #ei-{{ section.id }} .ins-stage {
    display: block;
    position: relative;
    width: 100%;
    max-width: {{ section.settings.image_size }}px;
    margin-inline: auto;
    aspect-ratio: 1 / 1;
    perspective: 1600px;
  }

  #ei-{{ section.id }} .ins-card {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transition: transform 0.85s cubic-bezier(0.3, 0.8, 0.25, 1);
  }
  #ei-{{ section.id }} .ins-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: 18px;
    overflow: hidden;
  }
  /* Only ever on the face you are looking at. A shadow on the hidden face is
     still cast by the 3D context, and shows as a stripe under the card. */
  #ei-{{ section.id }} .ins-face--back,
  #ei-{{ section.id }} .ins-card.is-settled .ins-face--front {
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.34);
  }
  #ei-{{ section.id }} .ins-face--front { transform: rotateY(180deg); }
  #ei-{{ section.id }} .ins-card.is-flipped { transform: rotateY(180deg); }

  /* Once the flip has finished, drop the 3D context altogether. Leaving the
     picture parked on a rotated compositor layer is exactly what made the
     product hero look soft — the layer keeps its pre-transform rasterisation.
     Flattening forces a fresh paint at the real size. */
  #ei-{{ section.id }} .ins-card.is-settled {
    transform: none;
    transition: none;
    transform-style: flat;
  }
  #ei-{{ section.id }} .ins-card.is-settled .ins-face--front {
    transform: none;
    backface-visibility: visible;
  }
  #ei-{{ section.id }} .ins-card.is-settled .ins-face--back { display: none; }

  /* A riffle of the deck before the card turns over. */
  #ei-{{ section.id }} .ins-card.is-shuffling { animation: ins-shuffle 0.5s ease-in-out; }
  @keyframes ins-shuffle {
    0%   { transform: rotateY(0deg) translateY(0) scale(1); }
    30%  { transform: rotateY(-8deg) translateY(-10px) scale(1.025); }
    62%  { transform: rotateY(6deg) translateY(-4px) scale(1.012); }
    100% { transform: rotateY(0deg) translateY(0) scale(1); }
  }

  #ei-{{ section.id }} .ins-face img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #ei-{{ section.id }} a.ins-stage-link { display: block; height: 100%; }

  /* The face-down card: a quiet seascape, drawn rather than uploaded so the
     section is never blank out of the box. The image setting replaces it when
     one is chosen. */
  #ei-{{ section.id }} .ins-back {
    display: block;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(34% 26% at 73% 24%, rgba(255, 255, 255, 0.13) 0%, rgba(255, 255, 255, 0) 72%),
      linear-gradient(185deg, {{ section.settings.card_from }} 0%, {{ section.settings.card_to }} 100%);
  }
  #ei-{{ section.id }} .ins-back svg { display: block; width: 100%; height: 100%; }

  /* The swells drift, slowly and out of step, so the card is never quite still.
     They are drawn wider than the card and clipped, so the ends never show. */
  #ei-{{ section.id }} .ins-swell { animation: ins-drift 17s ease-in-out infinite; }
  #ei-{{ section.id }} .ins-swell--2 { animation-duration: 23s; animation-direction: reverse; }
  #ei-{{ section.id }} .ins-swell--3 { animation-duration: 29s; }
  #ei-{{ section.id }} .ins-star { animation: ins-twinkle 7s ease-in-out infinite; }
  #ei-{{ section.id }} .ins-star--2 { animation-duration: 9.5s; animation-delay: 2.5s; }
  @keyframes ins-twinkle {
    0%, 100% { opacity: 0.4; }
    50%      { opacity: 0.12; }
  }
  @keyframes ins-drift {
    0%, 100% { transform: translateX(-16px); }
    50%      { transform: translateX(16px); }
  }

  #ei-{{ section.id }} .ins-eyebrow {
    margin: 0 0 0.8rem;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
  }
  #ei-{{ section.id }} .ins-heading {
    margin: 0;
    font-size: clamp(2.4rem, 1.9rem + 1.2vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: {{ section.settings.heading_color }};
    text-wrap: balance;
  }
  #ei-{{ section.id }} .ins-body {
    margin: 1.2rem 0 0;
    max-width: 46ch;
    font-size: 1.6rem;
    line-height: 1.65;
    color: {{ section.settings.body_color }};
  }
  #ei-{{ section.id }} .ins-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.4rem;
    margin-top: 2.2rem;
  }
  #ei-{{ section.id }} .ins-button {
    border: 0;
    border-radius: var(--pe-radius-button, 30px);
    padding: 1.3rem 3rem;
    font-size: 1.5rem;
    font-weight: 800;
    cursor: pointer;
    background: {{ section.settings.button_color }};
    color: {{ section.settings.button_text_color }};
    transition: transform 0.16s ease, opacity 0.3s ease;
  }
  #ei-{{ section.id }} .ins-button:not([disabled]):hover { transform: translateY(-2px); }
  #ei-{{ section.id }} .ins-button:not([disabled]):active { transform: translateY(1px) scale(0.98); }
  #ei-{{ section.id }} .ins-button[disabled] { opacity: 0.45; cursor: default; }
  #ei-{{ section.id }} .ins-visit {
    font-size: 1.5rem;
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }
  #ei-{{ section.id }} .ins-name {
    margin: 1.8rem 0 0;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
  }
  #ei-{{ section.id }} .ins-note {
    margin: 1rem 0 0;
    font-size: 1.35rem;
    color: {{ section.settings.body_color }};
  }
  #ei-{{ section.id }} .ins-rise { animation: ins-rise 0.55s ease both; }
  @keyframes ins-rise {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }
  #ei-{{ section.id }} [hidden] { display: none !important; }

  @media screen and (max-width: 749px) {
    #ei-{{ section.id }} .ins-layout { grid-template-columns: 1fr; gap: 2.6rem; }
    #ei-{{ section.id }} .ins-copy { text-align: center; }
    #ei-{{ section.id }} .ins-body { margin-inline: auto; }
    #ei-{{ section.id }} .ins-actions { justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    #ei-{{ section.id }} .ins-card,
    #ei-{{ section.id }} .ins-card.is-shuffling,
    #ei-{{ section.id }} .ins-swell,
    #ei-{{ section.id }} .ins-star,
    #ei-{{ section.id }} .ins-rise { animation: none; transition: none; }
    #ei-{{ section.id }} .ins-button { transition: none; }
  }
{% endstyle %}

<essence-inspiration
  id="ei-{{ section.id }}"
  class="ins-section"
  data-collection="{{ pool.handle | default: 'individual-essences' }}"
  data-key="ei-{{ section.id }}"
  data-sizes="(max-width: 749px) 92vw, {{ section.settings.image_size }}px"
>
  <div class="page-width">
    <div class="ins-layout">
      <div>
        <span class="ins-stage">
          <span class="ins-card" data-card>
            <span class="ins-face ins-face--back">
              {%- if section.settings.placeholder -%}
                {{
                  section.settings.placeholder
                  | image_url: width: 900
                  | image_tag: widths: '450, 700, 900', alt: ''
                }}
              {%- else -%}
                <span class="ins-back">
                  <svg viewBox="0 0 400 400" role="presentation" focusable="false" aria-hidden="true">
                    <g fill="{{ section.settings.card_mark }}">
                      <circle cx="72" cy="84" r="1.6" opacity="0.5"/>
                      <circle class="ins-star" cx="128" cy="52" r="1.2" opacity="0.38"/>
                      <circle cx="168" cy="128" r="1.4" opacity="0.42"/>
                      <circle cx="58" cy="170" r="1.2" opacity="0.3"/>
                      <circle cx="224" cy="74" r="1.1" opacity="0.3"/>
                      <circle class="ins-star ins-star--2" cx="330" cy="198" r="1.5" opacity="0.4"/>
                      <circle cx="106" cy="212" r="1" opacity="0.26"/>
                      <circle cx="268" cy="172" r="1.2" opacity="0.3"/>
                    </g>

                    <circle cx="292" cy="98" r="27" fill="{{ section.settings.card_mark }}" opacity="0.15"/>
                    <circle cx="292" cy="98" r="27" fill="none" stroke="{{ section.settings.card_mark }}" stroke-width="1" opacity="0.42"/>

                    <g>
                      <g class="ins-swell">
                        <path fill="{{ section.settings.card_water }}" opacity="0.24"
                              d="M-60 262 C30 232 110 290 200 268 C290 246 370 286 460 256 L460 420 L-60 420 Z"/>
                        <path fill="none" stroke="{{ section.settings.card_mark }}" stroke-width="1.2" opacity="0.22"
                              d="M-60 262 C30 232 110 290 200 268 C290 246 370 286 460 256"/>
                      </g>
                      <g class="ins-swell ins-swell--2">
                        <path fill="{{ section.settings.card_water }}" opacity="0.32"
                              d="M-60 294 C26 266 120 318 210 298 C296 280 380 316 460 290 L460 420 L-60 420 Z"/>
                        <path fill="none" stroke="{{ section.settings.card_mark }}" stroke-width="1.2" opacity="0.26"
                              d="M-60 294 C26 266 120 318 210 298 C296 280 380 316 460 290"/>
                      </g>
                      <g class="ins-swell ins-swell--3">
                        <path fill="{{ section.settings.card_water }}" opacity="0.36"
                              d="M-60 330 C40 304 128 350 214 332 C300 314 386 346 460 326 L460 420 L-60 420 Z"/>
                        <path fill="none" stroke="{{ section.settings.card_mark }}" stroke-width="1.2" opacity="0.3"
                              d="M-60 330 C40 304 128 350 214 332 C300 314 386 346 460 326"/>
                      </g>
                    </g>

                    <rect x="16" y="16" width="368" height="368" rx="11"
                          fill="none" stroke="{{ section.settings.card_mark }}" stroke-width="1" opacity="0.3"/>
                    <text x="200" y="360" text-anchor="middle"
                          font-family="inherit" font-size="12" letter-spacing="4.5"
                          fill="{{ section.settings.card_mark }}" opacity="0.6">PACIFIC ESSENCES</text>
                  </svg>
                </span>
              {%- endif -%}
            </span>

            <span class="ins-face ins-face--front" data-front></span>
          </span>
        </span>
      </div>

      <div class="ins-copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ins-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="ins-heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="ins-body">{{ section.settings.description }}</p>
        {%- endif -%}

        <p class="ins-name" data-name hidden></p>

        <div class="ins-actions">
          <button type="button" class="ins-button" data-draw>
            {{ section.settings.button_label | escape }}
          </button>
          <a class="ins-visit" data-visit href="#" hidden>
            {{ section.settings.visit_label | escape }}
          </a>
        </div>

        <p class="ins-note" data-note hidden>{{ section.settings.done_note | escape }}</p>
      </div>
    </div>
  </div>
</essence-inspiration>

<script>
  (function () {
    if (customElements.get('essence-inspiration')) return;

    customElements.define('essence-inspiration', class extends HTMLElement {
      connectedCallback() {
        this.card   = this.querySelector('[data-card]');
        this.front  = this.querySelector('[data-front]');
        this.stage  = this.querySelector('.ins-stage');
        this.button = this.querySelector('[data-draw]');
        this.visit  = this.querySelector('[data-visit]');
        this.nameEl = this.querySelector('[data-name]');
        this.note   = this.querySelector('[data-note]');
        this.key    = this.dataset.key;
        this.calm   = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.widths = [460, 700, 1080];

        this.button.addEventListener('click', () => this.draw());

        /* One draw per session. Kept in sessionStorage rather than a variable so
           it survives a reload and clears when the tab closes. Wrapped because a
           private window can throw on access rather than return null. */
        var already = null;
        try { already = sessionStorage.getItem(this.key); } catch (e) {}
        if (already) {
          try {
            var pick = JSON.parse(already);
            this.mount(pick);
            this.settle();
            this.announce(pick, false);
            return;
          } catch (e) {}
        }

        this.load();
      }

      /* Liquid cannot reach past 50 products in a collection, so the pool comes
         from the collection's own JSON. Fetched on load, one chosen straight
         away and mounted on the hidden face, so the flip turns over a picture
         that has already downloaded and painted. */
      load() {
        var url = '/collections/' + this.dataset.collection + '/products.json?limit=250';
        fetch(url, { credentials: 'same-origin' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then((data) => {
            if (!data || !data.products) return;
            this.pool = data.products.map(function (p) {
              var img = (p.images || []).filter(function (i) {
                return /IG|instagram/i.test(i.src.split('/').pop());
              })[0];
              if (!img) return null;
              return {
                src: img.src.split('?')[0],
                title: (p.title || '').split('|')[0].trim(),
                url: '/products/' + p.handle
              };
            }).filter(Boolean);

            if (!this.pool.length || this.drawn) return;
            this.chosen = this.pool[Math.floor(Math.random() * this.pool.length)];
            this.mount(this.chosen);
            if (this.waiting) { this.waiting = false; this.flip(this.chosen); }
          })
          .catch(function () {});
      }

      /* Hand the browser a set of widths and let it choose. Measuring the frame
         and asking the CDN for that exact size looked tidier, but the frame is
         still being laid out when the pool lands, so the measurement came back
         at nothing and the picture was fetched at 300px and stretched to 420 —
         which is the softness. Three widths rather than a fine ladder, on
         purpose: a Retina desktop then lands on 1080, the size the graphics
         were made at, so the CDN never resizes it and the browser scales it
         down exactly once. Lettering is baked into these pictures, and every
         extra resize costs a little of it. */
      mount(pick) {
        var img = new Image();
        img.alt = pick.title;
        img.src = pick.src + '?width=' + this.widths[this.widths.length - 1];
        img.srcset = this.widths.map(function (w) {
          return pick.src + '?width=' + w + ' ' + w + 'w';
        }).join(', ');
        img.sizes = this.dataset.sizes;
        img.loading = 'eager';
        img.decoding = 'sync';

        var link = document.createElement('a');
        link.className = 'ins-stage-link';
        link.href = pick.url;
        link.appendChild(img);

        this.front.innerHTML = '';
        this.front.appendChild(link);
        this.mounted = pick;
      }

      draw() {
        if (this.drawn) return;
        this.drawn = true;
        this.button.disabled = true;

        var pick = this.chosen;
        if (!pick) {
          /* The pool has not landed yet. Riffle the deck and turn over as soon
             as it does, rather than swallowing the click. */
          this.waiting = true;
          this.drawn = false;
          if (!this.calm) this.card.classList.add('is-shuffling');
          /* Don't strand the visitor on a dead button if the list never lands. */
          setTimeout(() => {
            if (this.waiting) { this.waiting = false; this.button.disabled = false; }
          }, 8000);
          return;
        }
        this.flip(pick);
      }

      flip(pick) {
        this.drawn = true;
        this.button.disabled = true;
        if (this.mounted !== pick) this.mount(pick);
        try { sessionStorage.setItem(this.key, JSON.stringify(pick)); } catch (e) {}

        if (this.calm) {
          this.settle();
          this.announce(pick, true);
          return;
        }

        this.card.classList.remove('is-shuffling');
        /* Restart the shuffle cleanly if one was already part-way through. */
        void this.card.offsetWidth;
        this.card.classList.add('is-shuffling');

        setTimeout(() => {
          this.card.classList.remove('is-shuffling');
          this.card.classList.add('is-flipped');
          this.announce(pick, true);
          setTimeout(() => this.settle(), 900);
        }, 500);
      }

      /* End the animation by taking the card out of 3D entirely — see the note
         on .is-settled above. */
      settle() {
        this.card.classList.remove('is-flipped', 'is-shuffling');
        this.card.classList.add('is-settled');
      }

      announce(pick, animate) {
        this.nameEl.textContent = pick.title;
        this.nameEl.hidden = false;
        this.visit.href = pick.url;
        this.visit.hidden = false;
        this.button.disabled = true;
        if (this.note) this.note.hidden = false;
        if (animate && !this.calm) {
          this.nameEl.classList.add('ins-rise');
          this.visit.classList.add('ins-rise');
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Daily inspiration",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Draw from",
      "info": "Only products in this collection that have a graphic are drawn. Defaults to Individual Essences."
    },

    { "type": "header", "content": "Words" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Today" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Daily Essence Inspiration" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Draw an essence" },
    { "type": "text", "id": "visit_label", "label": "Link to the product", "default": "Read about this essence" },
    { "type": "text", "id": "done_note", "label": "Note after the draw", "default": "Come back tomorrow for another." },

    { "type": "header", "content": "The face-down card" },
    {
      "type": "image_picker",
      "id": "placeholder",
      "label": "Your own picture",
      "info": "Optional. Leave empty to use the drawn card back below."
    },
    { "type": "color", "id": "card_from", "label": "Card, sky", "default": "#123a52" },
    { "type": "color", "id": "card_to", "label": "Card, depths", "default": "#04141d" },
    { "type": "color", "id": "card_water", "label": "Card, the swells", "default": "#5fb6d8" },
    { "type": "color", "id": "card_mark", "label": "Card, moon and lettering", "default": "#cfe9f6" },

    { "type": "header", "content": "Appearance" },
    { "type": "range", "id": "image_size", "min": 260, "max": 560, "step": 20, "unit": "px", "label": "Picture size", "default": 420 },
    { "type": "color", "id": "band_from", "label": "Band, top", "default": "#0f3446" },
    { "type": "color", "id": "band_to", "label": "Band, bottom", "default": "#16495f" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#7fc4e2" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#eaf6fb" },
    { "type": "color", "id": "body_color", "label": "Body text", "default": "#9dc0d1" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#eaf6fb" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#0f3446" },

    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "presets": [{ "name": "Daily inspiration" }]
}
{% endschema %}
