{%- comment -%}
  Contact.

  Dawn's contact form sits in a narrow centred column with the whole right-hand
  half of the page empty beside it. This is the same form — the markup is copied
  from sections/contact-form.liquid unchanged, so the validation, the error and
  success states and the translated labels all still work — with the details
  moved off the top and into the space next to it.

  The social links are read from the theme's own settings rather than typed in
  here, so they follow whatever the footer is set to and there is only ever one
  place to change them.
{%- endcomment -%}

{%- liquid
  assign has_social = false
  if settings.social_facebook_link != blank
    assign has_social = true
  endif
  if settings.social_instagram_link != blank
    assign has_social = true
  endif
  if settings.social_youtube_link != blank
    assign has_social = true
  endif
  if settings.social_tiktok_link != blank
    assign has_social = true
  endif
  if settings.social_pinterest_link != blank
    assign has_social = true
  endif
-%}

{% style %}
  #ec-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #ec-{{ section.id }} .ec-inner { max-width: 92rem; margin: 0 auto; }


  #ec-{{ section.id }} .ec-head { margin: 0 0 3rem; text-align: center; }
  #ec-{{ section.id }} .ec-title {
    margin: 0;
    font-size: clamp(2.4rem, 1.9rem + 1vw, 3.2rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: {{ section.settings.heading_color }};
    text-wrap: balance;
  }
  #ec-{{ section.id }} .ec-intro {
    max-width: 60ch;
    margin: 1rem auto 0;
    font-size: 1.6rem;
    line-height: 1.6;
    color: {{ section.settings.muted_color }};
  }

  #ec-{{ section.id }} .ec-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Dawn's own form styles do the work; these only undo the narrow centred
     column it assumes and tidy the button. */
  #ec-{{ section.id }} .ec-form .contact { padding: 0; max-width: none; }
  #ec-{{ section.id }} .ec-form .contact__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
    /* Dawn's name/email row carries no bottom margin of its own, so without
       this the phone field sits hard against it and the two borders touch. */
    margin-bottom: 1.4rem;
  }
  #ec-{{ section.id }} .ec-form .field { margin-bottom: 1.4rem; }
  #ec-{{ section.id }} .ec-form .contact__fields .field { margin-bottom: 0; }
  #ec-{{ section.id }} .ec-form .contact__button { margin-top: 0.6rem; }

  #ec-{{ section.id }} .ec-side {
    background: {{ section.settings.side_background }};
    border: 1px solid {{ section.settings.rule_color }};
    border-radius: 14px;
    padding: 2.4rem 2.6rem;
  }
  #ec-{{ section.id }} .ec-side-name {
    margin: 0 0 1.6rem;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: {{ section.settings.muted_color }};
  }
  #ec-{{ section.id }} .ec-item {
    display: block;
    margin-bottom: 1.8rem;
    text-decoration: none;
    color: inherit;
  }
  #ec-{{ section.id }} .ec-item-label {
    display: block;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ section.settings.muted_color }};
  }
  #ec-{{ section.id }} .ec-item-value {
    display: block;
    margin-top: 0.3rem;
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.35;
    color: {{ section.settings.value_color }};
    overflow-wrap: anywhere;
  }
  #ec-{{ section.id }} a.ec-item:hover .ec-item-value { color: {{ section.settings.link_color }}; }

  #ec-{{ section.id }} .ec-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.6rem;
    padding-top: 1.6rem;
    border-top: 1px solid {{ section.settings.rule_color }};
  }
  #ec-{{ section.id }} .ec-social a {
    font-size: 1.4rem;
    font-weight: 700;
    color: {{ section.settings.link_color }};
    text-decoration: none;
  }
  #ec-{{ section.id }} .ec-social a:hover { text-decoration: underline; }

  #ec-{{ section.id }} .ec-note {
    margin: 1.6rem 0 0;
    font-size: 1.35rem;
    line-height: 1.55;
    color: {{ section.settings.muted_color }};
  }

  @media screen and (max-width: 989px) {
    #ec-{{ section.id }} .ec-grid { grid-template-columns: 1fr; gap: 3rem; }
  }
  @media screen and (max-width: 599px) {
    #ec-{{ section.id }} .ec-form .contact__fields { grid-template-columns: 1fr; }
  }
{% endstyle %}

<div id="ec-{{ section.id }}" class="ec-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="ec-inner">
      {%- if section.settings.heading != blank or section.settings.intro != blank -%}
        <div class="ec-head">
          {%- if section.settings.heading != blank -%}
            <h1 class="ec-title">{{ section.settings.heading | escape }}</h1>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <p class="ec-intro">{{ section.settings.intro | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="ec-grid">
        <div class="ec-form">
          <div class="contact">
            {%- form 'contact', id: 'ContactForm', class: 'isolate' -%}
              {%- if form.posted_successfully? -%}
                <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
                  {{- 'icon-success.svg' | inline_asset_content -}}
                  {{ 'templates.contact.form.post_success' | t }}
                </h2>
              {%- elsif form.errors -%}
                <div class="form__message">
                  <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                    {{- 'icon-error.svg' | inline_asset_content -}}
                    {{ 'templates.contact.form.error_heading' | t }}
                  </h2>
                </div>
                <ul class="form-status-list caption-large" role="list">
                  <li>
                    <a href="#ContactForm-email" class="link">
                      {{ form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email }}
                    </a>
                  </li>
                </ul>
              {%- endif -%}
              <div class="contact__fields">
                <div class="field">
                  <input
                    class="field__input"
                    autocomplete="name"
                    type="text"
                    id="ContactForm-name"
                    name="contact[{{ 'templates.contact.form.name' | t }}]"
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                    placeholder="{{ 'templates.contact.form.name' | t }}"
                  >
                  <label class="field__label" for="ContactForm-name">
                    {{- 'templates.contact.form.name' | t -}}
                  </label>
                </div>
                <div class="field field--with-error">
                  <input
                    autocomplete="email"
                    type="email"
                    id="ContactForm-email"
                    class="field__input"
                    name="contact[email]"
                    spellcheck="false"
                    autocapitalize="off"
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                    aria-required="true"
                    {% if form.errors contains 'email' %}
                      aria-invalid="true"
                      aria-describedby="ContactForm-email-error"
                    {% endif %}
                    placeholder="{{ 'templates.contact.form.email' | t }}"
                  >
                  <label class="field__label" for="ContactForm-email">
                    {{- 'templates.contact.form.email' | t }}
                    <span aria-hidden="true">*</span></label
                  >
                  {%- if form.errors contains 'email' -%}
                    <small class="contact__field-error" id="ContactForm-email-error">
                      <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                      <span class="form__message">
                        <span class="svg-wrapper">
                          {{- 'icon-error.svg' | inline_asset_content -}}
                        </span>
                        {{- form.errors.translated_fields.email | capitalize }}
                        {{ form.errors.messages.email -}}
                      </span>
                    </small>
                  {%- endif -%}
                </div>
              </div>
              <div class="field">
                <input
                  type="tel"
                  id="ContactForm-phone"
                  class="field__input"
                  autocomplete="tel"
                  name="contact[{{ 'templates.contact.form.phone' | t }}]"
                  pattern="[0-9\-]*"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  placeholder="{{ 'templates.contact.form.phone' | t }}"
                >
                <label class="field__label" for="ContactForm-phone">
                  {{- 'templates.contact.form.phone' | t -}}
                </label>
              </div>
              <div class="field">
                <textarea
                  rows="10"
                  id="ContactForm-body"
                  class="text-area field__input"
                  name="contact[{{ 'templates.contact.form.comment' | t }}]"
                  placeholder="{{ 'templates.contact.form.comment' | t }}"
                >
                  {{- form.body -}}
                </textarea>
                <label class="form__label field__label" for="ContactForm-body">
                  {{- 'templates.contact.form.comment' | t -}}
                </label>
              </div>
              <div class="contact__button">
                <button type="submit" class="button">
                  {{ 'templates.contact.form.send' | t }}
                </button>
              </div>
            {%- endform -%}
          </div>
        </div>

        <aside class="ec-side">
          {%- if section.settings.side_name != blank -%}
            <p class="ec-side-name">{{ section.settings.side_name | escape }}</p>
          {%- endif -%}

          {%- if section.settings.email != blank -%}
            <a class="ec-item" href="mailto:{{ section.settings.email }}">
              <span class="ec-item-label">{{ section.settings.email_label | escape }}</span>
              <span class="ec-item-value">{{ section.settings.email }}</span>
            </a>
          {%- endif -%}

          {%- if section.settings.phone != blank -%}
            <a class="ec-item" href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' }}">
              <span class="ec-item-label">{{ section.settings.phone_label | escape }}</span>
              <span class="ec-item-value">{{ section.settings.phone }}</span>
            </a>
          {%- endif -%}

          {%- if has_social -%}
            <div class="ec-social">
              {%- if settings.social_facebook_link != blank -%}
                <a href="{{ settings.social_facebook_link }}">Facebook</a>
              {%- endif -%}
              {%- if settings.social_instagram_link != blank -%}
                <a href="{{ settings.social_instagram_link }}">Instagram</a>
              {%- endif -%}
              {%- if settings.social_youtube_link != blank -%}
                <a href="{{ settings.social_youtube_link }}">YouTube</a>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <a href="{{ settings.social_tiktok_link }}">TikTok</a>
              {%- endif -%}
              {%- if settings.social_pinterest_link != blank -%}
                <a href="{{ settings.social_pinterest_link }}">Pinterest</a>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.note != blank -%}
            <p class="ec-note">{{ section.settings.note | escape }}</p>
          {%- endif -%}
        </aside>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "textarea", "id": "intro", "label": "Line underneath" },

    { "type": "header", "content": "Details" },
    { "type": "text", "id": "side_name", "label": "Name above the details", "default": "Pacific Essences" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "email", "label": "Email address" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Phone" },
    { "type": "text", "id": "phone", "label": "Phone number" },
    { "type": "text", "id": "note", "label": "Note at the foot" },
    {
      "type": "paragraph",
      "content": "Social links come from the theme's own social settings, so they match the footer."
    },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#2a87b9" },
    { "type": "color", "id": "link_color", "label": "Links and hover", "default": "#2a87b9" },
    { "type": "color", "id": "value_color", "label": "Email and phone", "default": "#1c5b7d" },
    { "type": "color", "id": "muted_color", "label": "Labels and notes", "default": "#7c97a6" },
    { "type": "color", "id": "rule_color", "label": "Border", "default": "#e7eff4" },
    { "type": "color", "id": "side_background", "label": "Behind the details", "default": "#f2f8fb" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },

    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "presets": [{ "name": "Contact" }]
}
{% endschema %}
