    },
    {
      "type": "range",
      "id": "anim_trigger",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Open the flower at this point on screen",
      "default": 65,
      "info": "Measured from the top of the screen. Higher fires sooner as you scroll down; 50% is the middle of the viewport."
    },
    {
      "type": "range",
      "id": "anim_speed",
      "min": 50,
      "max": 220,
      "step": 10,
      "unit": "%",
      "label": "Animation duration",
      "default": 140,
      "info": "100% is about 1.2 seconds for the petals. Higher is slower and more gradual."
    },

    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Space between the parts",
      "default": 32,
      "info": "Gap between the heading, the chat, the divider and the flower."
    },

    { "type": "header", "content": "Section style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "color", "id": "band_start", "label": "Background top colour", "default": "#f7fbfd" },
    { "type": "color", "id": "band_end", "label": "Background bottom colour", "default": "#f2f8f5" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "blocks": [
    {
      "type": "petal",
      "name": "Petal",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "petal_image", "label": "Petal image" },
        { "type": "collection", "id": "collection_link", "label": "Collection link" },
        { "type": "text", "id": "petal_label", "label": "Petal text", "info": "The words drawn on this petal. e.g. Experiencing Fear, Seeking Courage" },
        { "type": "paragraph", "content": "This petal's size, its place on the flower, and where its words sit are measured from the artwork and set in the section's CSS. Nothing to position here." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Essence guide",
      "blocks": [
        { "type": "petal" },
        { "type": "petal" },
        { "type": "petal" },
        { "type": "petal" },
        { "type": "petal" }
      ]
    }
  ]
}
