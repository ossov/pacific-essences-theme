      "default": "h1"
    },

    { "type": "header", "content": "Chat" },
    {
      "type": "text",
      "id": "endpoint",
      "label": "Backend endpoint URL",
      "default": "/apps/essence-chat/chat-v2",
      "info": "Routes through the Shopify App Proxy. Leave as-is."
    },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "I'm feeling..." },
    { "type": "color", "id": "accent", "label": "Chat accent colour", "default": "#2A87B9" },
    { "type": "color", "id": "glow_color", "label": "Chat glow colour", "default": "#43a6db" },
    {
      "type": "range",
      "id": "glow_strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Chat glow strength",
      "default": 45,
      "info": "0 turns the glow off and restores the widget's own shadow."
    },
    {
      "type": "range",
      "id": "chat_height",
      "min": 0,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Extra chat height",
