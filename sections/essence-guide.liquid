      "default": 55,
      "info": "Milliseconds per character. Lower is faster."
    },
    {
      "type": "range",
      "id": "type_hold",
      "min": 500,
      "max": 4000,
      "step": 100,
      "unit": "ms",
      "label": "Hold each phrase",
      "default": 1600
    },

    { "type": "header", "content": "Divider" },
    { "type": "checkbox", "id": "show_seam", "label": "Show the divider", "default": true },
    { "type": "text", "id": "seam_label", "label": "Divider label", "default": "or point to what fits" },
    {
      "type": "range",
      "id": "seam_text_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Divider text size",
      "default": 15,
      "info": "The bubble grows with the text."
    },
    {
      "type": "range",
      "id": "seam_line_width",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Divider line thickness",
      "default": 3
    },
    { "type": "color", "id": "seam_color", "label": "Divider line colour", "default": "#2a87b9" },
    { "type": "color", "id": "seam_text_color", "label": "Divider label colour", "default": "#4d7387" },
    { "type": "range", "id": "seam_length", "min": 8, "max": 90, "step": 2, "unit": "px", "label": "Line length", "default": 26 },

    { "type": "header", "content": "Flower menu" },
    { "type": "text", "id": "flower_title", "label": "Flower heading" },
    { "type": "richtext", "id": "flower_subtitle", "label": "Flower sub-heading" },
    { "type": "range", "id": "section_height", "min": 200, "max": 1000, "step": 20, "unit": "px", "label": "Flower height", "default": 500 },
